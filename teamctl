Konfiguration: siehe teamctl.env im Skript-Verzeichnis (Vorlage: .env.example).
           TEAMCTL_INFRA_HOST TEAMCTL_WIKI_URL TEAMCTL_WIKI_EMAIL TEAMCTL_BLOG_ROOT
           TEAMCTL_GIT_OWNER TEAMCTL_GIT_API TEAMCTL_SSH_KEY TEAMCTL_WIKI_CREDS
EOF
}

# ---------------- SSH ----------------
ssh_ready() { [ -f "$SSH_KEY" ] || die "SSH-Key nicht gefunden: $SSH_KEY (TEAMCTL_SSH_KEY setzen)"; }
ssh_run()  { ssh_ready; ssh -i "$SSH_KEY" "${SSH_OPTS[@]}" "$INFRA_HOST" "$@"; }
scp_to()   { ssh_ready; scp -q -i "$SSH_KEY" "${SSH_OPTS[@]}" "$1" "$INFRA_HOST:$2"; }
scp_from() { ssh_ready; scp -q -i "$SSH_KEY" "${SSH_OPTS[@]}" "$INFRA_HOST:$1" "$2"; }

# ---------------- Wiki (Docmost) ----------------

# shq <text> - Argument fuer die REMOTE-Shell (ssh) sicher in einfache
# Anfuehrungszeichen setzen. Eingebettete Single-Quotes werden remote maskiert -
# der Wert kann so nie aus den Quotes ausbrechen (H1: Command-Injection).
shq() { awk -v s="$1" 'BEGIN{ gsub("\047","\047\134\047\047",s); printf "\047%s\047", s }'; }

# wiki_as_validate <wert> - Whitelist fuer --as/WIKI_AS (H1).
# Erlaubt nur Buchstaben, Ziffern, '. _ @ + -' und Leerzeichen (Name/Email).
# Alles andere (Metazeichen wie Quotes, ; & | $, Backticks, Klammern) und
# Zeilenumbrueche werden abgelehnt; die Meldung nennt nur den Optionsnamen.
wiki_as_validate() {
  local who="$1" bad
  [ -n "$who" ] || die "wiki: --as ist leer"
  bad="$(printf '%s' "$who" | LC_ALL=C tr -d 'A-Za-z0-9._@+ -' | LC_ALL=C tr -d '\200-\377')"
  [ -z "$bad" ] || die "wiki: --as ungueltig - erlaubt sind nur Buchstaben, Ziffern, . _ @ + - und Leerzeichen"
}
wiki_resolve_email() {
  local who="$1"
  wiki_as_validate "$who"
  if [[ "$who" == *@* ]]; then printf '%s' "$who"; return 0; fi
  ssh_run "awk -F'|' -v q=$(shq "$who") '\$1 ~ /^#/ {next} q ~ /@/ {if (\$3==q) {print \$3; exit} next} \$2==q {print \$3; exit} \$3==q {print \$3; exit} {n=split(\$3,a,\"@\"); if (a[1]==q) {print \$3; exit}}' $(shq "$WIKI_CREDS") 2>/dev/null"
}

wiki_login() {
  local who="$1" email pw code
  email="$(wiki_resolve_email "$who")"
  [ -n "$email" ] || die "Wiki-Konto '$who' nicht in $WIKI_CREDS gefunden"
  pw="$(ssh_run "awk -F'|' -v e=$(shq "$email") '\$3==e{print \$4; exit}' $(shq "$WIKI_CREDS") 2>/dev/null")"
  [ -n "$pw" ] || die "Kein Passwort fuer '$email' in $WIKI_CREDS gefunden"
  WIKI_COOKIE="$(mktmp)"
  code="$(wiki_http /dev/null -X POST \
    "$WIKI_BASE/api/auth/login" -H 'Content-Type: application/json' \
    --data-binary "$(jq -nc --arg e "$email" --arg p "$pw" '{email:$e,password:$p}')" \
    -c "$WIKI_COOKIE")"
  [ "$code" = "200" ] || die "Wiki-Login '$email' fehlgeschlagen (HTTP $code)"
}

wiki_api() {
  local ep="$1" body="$2" f
  [ -n "$body" ] || body='{}'
  f="$(mktmp)"
  WIKI_HTTP="$(wiki_http "$f" -X POST "$WIKI_BASE/api/$ep" \
    -H 'Content-Type: application/json' -b "$WIKI_COOKIE" --data-binary "$body")"
  WIKI_BODY="$(cat "$f")"
  case "$WIKI_HTTP" in 200|201) return 0 ;; *) return 1 ;; esac
}

wiki_err() { printf '%s' "$WIKI_BODY" | jq -r '.message // .error // empty' 2>/dev/null | head -1; }

wiki_api_or_die() {
  wiki_api "$1" "$2" || { note "Wiki: HTTP $WIKI_HTTP bei POST /api/$1: $(wiki_err)"; return 1; }
}

# wiki_words - normalisierte Wortliste eines Textes (ein Token pro Zeile, sortiert).
# Liest stdin. Alles ausserhalb [[:alnum:]] trennt; damit ist der Vergleich
# unabhaengig von der Markdown-Umserialisierung des Wikis (Zeilenenden,
# Einrueckung, Tabellen-Ausrichtung, *x* vs. _x_).
wiki_words() {
  LC_ALL=C.UTF-8 grep -oE '[[:alnum:]]+' 2>/dev/null | LC_ALL=C sort || true
}

# wiki_verify_content <pageId> <datei> <kontext>
# Vollstaendiger, normalisierter Inhalts-Read-back statt eines zufaelligen
# Einzel-Tokens: JEDES Wort-Token der lokalen Datei muss in der gespeicherten
# Fassung (pages/info, format=markdown) enthalten sein - als Multimenge,
# Reihenfolge egal. Fehlt auch nur ein Token, schlaegt die Verifikation fehl
# (Exit != 0) mit knapper Meldung (Anzahl + Beispiele). Ein Inhalt ganz ohne
# pruefbares Wort-Token (leer/nur Satzzeichen) ist ein Fehler, weil dann nichts
# verifizierbar ist. Der Read-back direkt nach dem Schreiben kann veralteten
# Inhalt liefern (Eventual Consistency); daher begrenzt wiederholen (max 4
# Versuche, Pausen 1s/2s/3s), bevor gemeldet wird.
wiki_verify_content() {
  local page="$1" file="$2" ctx="$3"
  local lf rf content missing attempt ntokens
  lf="$(mktmp)"; rf="$(mktmp)"
  wiki_words < "$file" > "$lf"
  if [ ! -s "$lf" ]; then
    die "$ctx: Verifikation nicht moeglich (Inhalt ohne pruefbares Wort, id=$page)"
  fi
  attempt=1
  while :; do
    wiki_api_or_die "pages/info" \
      "$(jq -nc --arg p "$page" '{pageId:$p, format:"markdown", includeContent:true}')" \
      || die "$ctx: Read-back fehlgeschlagen (id=$page)"
    content="$(printf '%s' "$WIKI_BODY" | jq -r '.data.content // ""')"
    printf '%s' "$content" | wiki_words > "$rf"
    missing="$(LC_ALL=C comm -23 "$lf" "$rf")"
    if [ -z "$missing" ]; then return 0; fi
    [ "$attempt" -ge 4 ] && break
    sleep "$attempt"
    attempt=$(( attempt + 1 ))
  done
  ntokens="$(printf '%s\n' "$missing" | wc -l | tr -d ' ')"
  die "$ctx: Verifikation fehlgeschlagen ($ntokens Wort-Token fehlen, z. B. $(printf '%s' "$missing" | head -3 | tr '\n' ' '), id=$page)"
}

wiki_fetch_sidebar() {
  local space="$1" page="$2" body
  if [ -n "$page" ]; then
    body="$(jq -nc --arg s "$space" --arg p "$page" '{spaceId:$s,pageId:$p}')"
  else
    body="$(jq -nc --arg s "$space" '{spaceId:$s}')"
  fi
  wiki_api "pages/sidebar-pages" "$body" || { note "Wiki: HTTP $WIKI_HTTP bei POST /api/pages/sidebar-pages: $(wiki_err)"; return 1; }
}

wiki_print_tree() {
  local space="$1" json="$2" ind="$3" id title hc sub
  while IFS=$'\t' read -r id title hc; do
    [ -n "$id" ] || continue
    printf '%s%s\t%s\n' "$ind" "$id" "$title"
    if [ "$hc" = "true" ]; then
      wiki_fetch_sidebar "$space" "$id"
      sub="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items')"
      wiki_print_tree "$space" "$sub" "$ind  "
    fi
  done < <(printf '%s' "$json" | jq -r '.[] | [.id, .title, (.hasChildren|tostring)] | @tsv')
}

wiki_spaces() {
  wiki_login "$WIKI_AS"
  wiki_api_or_die "spaces/" '{}'
  printf '%s' "$WIKI_BODY" | jq -r '.data.items[] | [.id, .slug, .name] | @tsv'
}

wiki_pages() {
  [ $# -ge 1 ] || die "wiki pages: <spaceId> fehlt"
  local space="$1"
  wiki_login "$WIKI_AS"
  wiki_fetch_sidebar "$space" ""
  local items; items="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items')"
  wiki_print_tree "$space" "$items" ""
}

# Flacht den Seitenbaum eines Spaces ab und gibt je Zeile
# spaceSlug<TAB>pageId<TAB>title aus (fuer wiki search).
wiki_collect_pages() {
  local space="$1" slug="$2" json="$3" id title hc sub
  while IFS=$'\t' read -r id title hc; do
    [ -n "$id" ] || continue
    printf '%s\t%s\t%s\n' "$slug" "$id" "$title"
    if [ "$hc" = "true" ]; then
      wiki_fetch_sidebar "$space" "$id"
      sub="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items')"
      wiki_collect_pages "$space" "$slug" "$sub"
    fi
  done < <(printf '%s' "$json" | jq -r '.[] | [.id, .title, (.hasChildren|tostring)] | @tsv')
}

# Sucht Wiki-Seiten (case-insensitive, fester String). Ausgabe je Treffer:
# spaceSlug<TAB>pageId<TAB>title (nach Titel sortiert).
#
# Standard ist die VOLLTEXTSUCHE ueber Titel, Body und Tags-Zeile. Quelle ist
# der lokale Markdown-Export (WIKI_EXPORT_DIR bzw. ~/.openclaw/wiki), den
# 'teamctl wiki export' pflegt - ohne Netzwerkzugriff. Existiert kein Export,
# folgt ein Hinweis und die titelbasierte API-Suche als Fallback. Ist der
# Export aelter als TEAMCTL_WIKI_SEARCH_MAX_AGE Stunden (Default 24), warnt
# teamctl auf stderr; die Suche laeuft trotzdem auf dem Export weiter.
#
# Optionen:
#   --title             nur Titel ueber die Docmost-API suchen (ohne Export)
#   --full              Volltextsuche ueber den Export erzwingen (Default)
#   --export-dir DIR    anderes Exportverzeichnis (sonst WIKI_EXPORT_DIR)
wiki_search() {
  local q="" mode="full" exp_dir=""
  while [ $# -gt 0 ]; do case "$1" in
    --title)      mode="title"; shift ;;
    --full)       mode="full"; shift ;;
    --export-dir) [ $# -ge 2 ] || die "wiki search: --export-dir braucht einen Wert"; exp_dir="$2"; shift 2 ;;
    --)           shift; break ;;
    -*)           die "wiki search: unbekannte Option '$1'" ;;
    *)            [ -z "$q" ] || die "wiki search: nur ein Suchbegriff erlaubt"; q="$1"; shift ;;
  esac; done
  if [ -z "$q" ] && [ $# -ge 1 ]; then q="$1"; shift; fi
  [ $# -eq 0 ] || die "wiki search: nur ein Suchbegriff erlaubt"
  [ -n "$q" ] || die "wiki search: <begriff> fehlt"
  if [ "$mode" = "full" ]; then
    local dir="${exp_dir:-${WIKI_EXPORT_DIR:-$HOME/.openclaw/wiki}}"
    if [ -d "$dir" ] && { [ -f "$dir/.wiki-sync-manifest.tsv" ] || [ -n "$(find "$dir" -maxdepth 1 -type f -name '*.md' -print -quit 2>/dev/null)" ]; }; then
      wiki_search_stale_note "$dir"
      wiki_search_export "$q" "$dir" | sort -f -t $'\t' -k3,3
      return $?
    fi
    note "wiki search: kein Wiki-Export in '$dir' gefunden - Fallback auf titelbasierte API-Suche; fuer die Volltextsuche 'teamctl wiki export' ausfuehren."
  fi
  wiki_search_titles "$q"
}

# wiki_search_stale_note <dir>
# Warnt auf stderr, wenn der Export aelter als TEAMCTL_WIKI_SEARCH_MAX_AGE
# Stunden (Default 24) ist. Bezug ist die neueste Datei (Seite oder Manifest).
wiki_search_stale_note() {
  local dir="$1" max_age="${TEAMCTL_WIKI_SEARCH_MAX_AGE:-24}" newest now age_h
  case "$max_age" in ''|*[!0-9]*) max_age=24 ;; esac
  newest="$(find "$dir" -maxdepth 1 -type f \( -name '*.md' -o -name '.wiki-sync-manifest.tsv' \) -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)"
  [ -n "$newest" ] || return 0
  now="$(date +%s)"
  age_h=$(( (now - newest) / 3600 ))
  if [ "$age_h" -ge "$max_age" ]; then
    note "wiki search: Export ist ca. ${age_h}h alt (>= ${max_age}h) - fuer aktuelle Treffer 'teamctl wiki export' ausfuehren."
  fi
  return 0
}

# wiki_search_export <begriff> <dir>
# Volltextsuche ueber die Markdown-Dateien eines Export-Verzeichnisses
# (Titel, Body und Tags-Zeile). Index ist das Manifest
# (.wiki-sync-manifest.tsv: fname<TAB>pageId<TAB>spaceSlug<TAB>title);
# fehlt es, werden die YAML-Kopfzeilen (title/space/pageId) gelesen.
# Exit: 0 = mindestens ein Treffer, 1 = kein Treffer (wie grep).
wiki_search_export() {
  local q="$1" dir="$2" fname pageId space title f hits=0
  if [ -f "$dir/.wiki-sync-manifest.tsv" ]; then
    while IFS=$'\t' read -r fname pageId space title; do
      [ -n "$fname" ] || continue
      [ -f "$dir/$fname" ] || continue
      grep -qiF -- "$q" "$dir/$fname" || continue
      printf '%s\t%s\t%s\n' "$space" "$pageId" "$title"
      hits=$((hits + 1))
    done < "$dir/.wiki-sync-manifest.tsv"
    [ "$hits" -gt 0 ]
    return $?
  fi
  while IFS= read -r -d '' f; do
    grep -qiF -- "$q" "$f" || continue
    pageId="$(sed -n 's/^pageId:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' "$f" | head -1)"
    space="$(sed -n  's/^space:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' "$f" | head -1)"
    title="$(sed -n  's/^title:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' "$f" | head -1)"
    printf '%s\t%s\t%s\n' "$space" "$pageId" "$title"
    hits=$((hits + 1))
  done < <(find "$dir" -maxdepth 1 -type f -name '*.md' -print0 2>/dev/null)
  [ "$hits" -gt 0 ]
  return $?
}

# wiki_search_titles <begriff>
# Sucht seitenuebergreifend nur nach Seitentiteln ueber die Docmost-API
# (case-insensitive, fester String). Ausgabe: spaceSlug<TAB>pageId<TAB>title.
wiki_search_titles() {
  local q="$1" tmp
  wiki_login "$WIKI_AS"
  wiki_api_or_die "spaces/" '{}'
  local spaces
  spaces="$(printf '%s' "$WIKI_BODY" | jq -r '.data.items[] | [.id, .slug] | @tsv')"
  [ -n "$spaces" ] || die "wiki search: keine Spaces sichtbar"
  tmp="$(mktmp)"
  local sid slug items
  while IFS=$'\t' read -r sid slug; do
    [ -n "$sid" ] || continue
    wiki_fetch_sidebar "$sid" "" || continue
    items="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items')"
    wiki_collect_pages "$sid" "$slug" "$items" >> "$tmp"
  done <<< "$spaces"
  grep -iF -- "$q" "$tmp" | sort -f -t $'\t' -k3,3
}

wiki_get() {
  [ $# -ge 1 ] || die "wiki get: <pageId> fehlt"
  local page="$1"
  wiki_login "$WIKI_AS"
  wiki_api_or_die "pages/info" "$(jq -nc --arg p "$page" '{pageId:$p, format:"markdown", includeContent:true}')"
  printf '%s\n\n' "$(printf '%s' "$WIKI_BODY" | jq -r '.data.title')"
  printf '%s\n' "$(printf '%s' "$WIKI_BODY" | jq -r '.data.content // ""')"
}

wiki_create() {
  local space="" title="" file="" parent="" parent_set=0 body id rt rp
  while [ $# -gt 0 ]; do case "$1" in
    --space)  [ $# -ge 2 ] || die "wiki create: --space braucht einen Wert"; space="$2"; shift 2 ;;
    --title)  [ $# -ge 2 ] || die "wiki create: --title braucht einen Wert"; title="$2"; shift 2 ;;
    --file)   [ $# -ge 2 ] || die "wiki create: --file braucht einen Wert"; file="$2"; shift 2 ;;
    --parent) [ $# -ge 2 ] || die "wiki create: --parent braucht einen Wert"; parent="$2"; parent_set=1; shift 2 ;;
    --as)     [ $# -ge 2 ] || die "wiki create: --as braucht einen Wert"; WIKI_AS="$2"; shift 2 ;;
    *) die "wiki create: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$space" ] || die "wiki create: --space fehlt"
  [ -n "$title" ] || die "wiki create: --title fehlt"
  [ -n "$file" ] || die "wiki create: --file fehlt"
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  wiki_login "$WIKI_AS"
  if [ -n "$parent" ]; then
    body="$(jq -nc --arg s "$space" --arg t "$title" --arg p "$parent" --rawfile c "$file" '{spaceId:$s,title:$t,parentPageId:$p,content:$c,format:"markdown"}')"
  else
    body="$(jq -nc --arg s "$space" --arg t "$title" --rawfile c "$file" '{spaceId:$s,title:$t,content:$c,format:"markdown"}')"
  fi
  wiki_api_or_die "pages/create" "$body"
  id="$(printf '%s' "$WIKI_BODY" | jq -r '.data.id // empty')"
  [ -n "$id" ] || die "wiki create: keine Page-ID in der Antwort"
  wiki_api_or_die "pages/info" "$(jq -nc --arg p "$id" '{pageId:$p}')"
  rt="$(printf '%s' "$WIKI_BODY" | jq -r '.data.title // empty')"
  [ "$rt" = "$title" ] || die "wiki create: Verifikation fehlgeschlagen (Titel '$rt' != '$title', id=$id)"
  # --parent wird - wie bei 'wiki update' - gegen parentPageId geprueft: nur den
  # Titel zu verifizieren war die gleiche blinde Stelle wie Issue #22.
  if [ "$parent_set" -eq 1 ]; then
    rp="$(printf '%s' "$WIKI_BODY" | jq -r '.data.parentPageId // empty')"
    [ "$rp" = "$parent" ] || die "wiki create: Verifikation fehlgeschlagen (parentPageId '${rp:-null}' != '${parent:-null}', id=$id)"
  fi
  # Inhalt vollstaendig/normalisiert verifizieren (nicht nur den Titel).
  wiki_verify_content "$id" "$file" "wiki create"
  printf '%s\n' "$id"
}

# wiki_pos_after <nachbarposition>
# Erzeugt eine fractional-index-Position, die NACH <nachbarposition> sortiert.
# Docmost verlangt beim Umhaengen (pages/move) eine position von 5-12 Zeichen
# und sortiert lexikographisch. Leere Liste -> Startwert "a0VVV"; sonst wird
# 'V' angehaengt, was garantiert dahinter sortiert. Rueckgabe != 0, wenn die
# Nachbarposition bereits die Maximalbreite von 12 Zeichen erreicht hat.
wiki_pos_after() {
  local max="$1" out
  if [ -z "$max" ]; then out="a0"; else out="$max"; fi
  out="${out}V"
  while [ "${#out}" -lt 5 ]; do out="${out}V"; done
  [ "${#out}" -le 12 ] || return 1
  printf '%s' "$out"
}

# wiki_reparent <pageId> <zielParentPageId|"">
# Haengt eine bestehende Seite um. Docmost ignoriert parentPageId in
# pages/update (Issue #22) - das Umhaengen laeuft daher ueber
# POST /api/pages/move {pageId, parentPageId, position}; position ist Pflicht.
# Ein leerer Zielwert loest die Seite vom Parent (parentPageId null = Root).
# Die Seite landet am ENDE der Ziel-Elternliste: Position = groesste
# Nachbarposition (ohne die Seite selbst) + 'V', bei leerer Liste "a0VVV".
# Read-back ueber pages/info: parentPageId muss dem Ziel entsprechen, sonst
# Fehler (Exit != 0).
wiki_reparent() {
  local page="$1" target="$2"
  local space siblings maxpos newpos body cur
  wiki_api_or_die "pages/info" "$(jq -nc --arg p "$page" '{pageId:$p}')" \
    || die "wiki update: Seite nicht lesbar (id=$page)"
  space="$(printf '%s' "$WIKI_BODY" | jq -r '.data.spaceId // empty')"
  [ -n "$space" ] || die "wiki update: spaceId nicht ermittelbar (id=$page)"
  if [ -n "$target" ]; then
    wiki_fetch_sidebar "$space" "$target" \
      || die "wiki update: Ziel-Parent '$target' nicht lesbar"
  else
    wiki_fetch_sidebar "$space" "" \
      || die "wiki update: Seitenliste des Space nicht lesbar"
  fi
  siblings="$(printf '%s' "$WIKI_BODY" | jq -r --arg self "$page" \
    '.data.items[]? | select(.id != $self) | .position // empty')"
  maxpos="$(printf '%s\n' "$siblings" | jq -Rrs 'split("\n") | map(select(length > 0)) | sort | last // ""')"
  newpos="$(wiki_pos_after "$maxpos")" \
    || die "wiki update: --parent: keine gueltige position generierbar (Nachbarposition hat bereits die Maximalbreite von 12 Zeichen)"
  if [ -n "$target" ]; then
    body="$(jq -nc --arg p "$page" --arg par "$target" --arg pos "$newpos" \
      '{pageId:$p,parentPageId:$par,position:$pos}')"
  else
    body="$(jq -nc --arg p "$page" --arg pos "$newpos" \
      '{pageId:$p,parentPageId:null,position:$pos}')"
  fi
  wiki_api_or_die "pages/move" "$body" \
    || die "wiki update: Umhaengen fehlgeschlagen (id=$page, HTTP $WIKI_HTTP)"
  wiki_api_or_die "pages/info" "$(jq -nc --arg p "$page" '{pageId:$p}')" \
    || die "wiki update: Read-back fehlgeschlagen (id=$page)"
  cur="$(printf '%s' "$WIKI_BODY" | jq -r '.data.parentPageId // empty')"
  if [ "$cur" != "$target" ]; then
    die "wiki update: Verifikation fehlgeschlagen - parentPageId ist '${cur:-null}', erwartet '${target:-null}' (id=$page)"
  fi
}

wiki_update() {
  [ $# -ge 1 ] || die "wiki update: <pageId> fehlt"
  local page="$1"; shift
  local file="" mode="replace" parent="" parent_set=0 body
  while [ $# -gt 0 ]; do case "$1" in
    --file) [ $# -ge 2 ] || die "wiki update: --file braucht einen Wert"; file="$2"; shift 2 ;;
    --mode) [ $# -ge 2 ] || die "wiki update: --mode braucht einen Wert"; mode="$2"; shift 2 ;;
    --parent) [ $# -ge 2 ] || die "wiki update: --parent braucht einen Wert"; parent="$2"; parent_set=1; shift 2 ;;
    --as)   [ $# -ge 2 ] || die "wiki update: --as braucht einen Wert"; WIKI_AS="$2"; shift 2 ;;
    *) die "wiki update: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$file" ] || die "wiki update: --file fehlt"
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  case "$mode" in replace|append|prepend) ;; *) die "wiki update: ungueltiger --mode '$mode' (replace|append|prepend)" ;; esac
  wiki_login "$WIKI_AS"
  # parentPageId in pages/update wird von Docmost ignoriert (Issue #22) und
  # daher nicht mehr mitgesendet; --parent laeuft ueber pages/move.
  body="$(jq -nc --arg p "$page" --arg m "$mode" --rawfile c "$file" '{pageId:$p,content:$c,format:"markdown",operation:$m}')"
  wiki_api_or_die "pages/update" "$body" \
    || die "wiki update: Inhalt konnte nicht geschrieben werden (id=$page, HTTP $WIKI_HTTP)"
  # --parent setzt/loest den Parent TATSAECHLICH (move + Read-back).
  if [ "$parent_set" -eq 1 ]; then
    wiki_reparent "$page" "$parent"
  fi
  # Vollstaendiger, normalisierter Inhalts-Read-back: ALLE Wort-Token der Datei
  # muessen in der gespeicherten Fassung vorkommen (statt eines zufaelligen
  # Einzel-Tokens). Ein leerer Inhalt ist ein Fehler.
  wiki_verify_content "$page" "$file" "wiki update"
  printf 'OK\t%s\t%s\n' "$page" "$mode"
}

wiki_upload() {
  [ $# -ge 2 ] || die "wiki upload: <pageId> <bilddatei> fehlt"
  local page="$1" file="$2" f url code
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  wiki_login "$WIKI_AS"
  f="$(mktmp)"
  WIKI_HTTP="$(wiki_http "$f" -X POST "$WIKI_BASE/api/files/upload" \
    -b "$WIKI_COOKIE" -F "pageId=$page" -F "file=@$file")"
  WIKI_BODY="$(cat "$f")"
  case "$WIKI_HTTP" in 200|201) ;; *) die "HTTP $WIKI_HTTP bei POST /api/files/upload: $(wiki_err)" ;; esac
  url="$(printf '%s' "$WIKI_BODY" | jq -r '.url // .data.url // empty')"
  [ -n "$url" ] || die "wiki upload: keine URL in der Antwort"
  code="$(wiki_http /dev/null -L -b "$WIKI_COOKIE" "$url")"
  [ "$code" = "200" ] || die "wiki upload: Read-back fehlgeschlagen (HTTP $code, $url)"
  printf '%s\n' "$url"
}

wiki_me() {
  wiki_login "$WIKI_AS"
  local f
  f="$(mktmp)"
  WIKI_HTTP="$(wiki_http "$f" -X POST "$WIKI_BASE/api/users/me" -H 'Content-Type: application/json' --data-binary '{}' -b "$WIKI_COOKIE")"
  WIKI_BODY="$(cat "$f")"
  local name
  name="$(printf '%s' "$WIKI_BODY" | jq -r '.data.user.name // empty')"
  printf '%s\n' "$name"
}

wiki_profile() {
  [ $# -ge 1 ] || die "wiki profile: --name <name> fehlt"
  local name=""
  while [ $# -gt 0 ]; do case "$1" in
    --name) [ $# -ge 2 ] || die "wiki profile: --name braucht einen Wert"; name="$2"; shift 2 ;;
    *) die "wiki profile: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$name" ] || die "wiki profile: --name fehlt"

  wiki_login "$WIKI_AS"

  # Set new name
  local body
  body=$(jq -nc --arg n "$name" '{name:$n}')
  wiki_api "users/update" "$body" || die "HTTP $WIKI_HTTP bei POST /api/users/update: $(wiki_err)"

  # Read back
  local f
  f="$(mktmp)"
  WIKI_HTTP="$(wiki_http "$f" -X POST "$WIKI_BASE/api/users/me" -H 'Content-Type: application/json' --data-binary '{}' -b "$WIKI_COOKIE")"
  WIKI_BODY="$(cat "$f")"

  local new_name
  new_name="$(printf '%s' "$WIKI_BODY" | jq -r '.data.user.name // empty')"
  printf 'OK\tName aktualisiert auf: %s\n' "$new_name"
}


# wiki_slugify <text> - Dateiname-taugliches Slug (ASCII, kleingeschrieben).
wiki_slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/ä/ae/g; s/ö/oe/g; s/ü/ue/g; s/ß/ss/g' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-80
}

# wiki_yaml_escape <text> - Backslash und Anfuehrungszeichen fuer YAML maskieren.
wiki_yaml_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# wex_log <quiet> <text...> - Fortschritt auf stderr; mit --quiet unterdrueckt.
wex_log() { local q="$1"; shift; [ "$q" -eq 1 ] || printf 'teamctl: %s\n' "$*" >&2; }

# wex_schema_file <basename> - entspricht der Dateiname dem Export-Schema
# <space-slug>__<page-slug>[-<pid8>].md? Slugs stammen aus wiki_slugify
# ([a-z0-9-]); <pid8> sind die ersten 8 Zeichen der Seiten-ID.
wex_schema_file() {
  printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]*__[a-z0-9][a-z0-9-]*(-[A-Za-z0-9]{8})?\.md$'
}

# wex_tsv <text> - entschaerft ein Manifest-/TSV-Feld (N4): echte Tabs, CR und
# LF wuerden die spaltige Struktur von .wiki-sync-manifest.tsv zerstoeren und
# werden daher durch Leerzeichen ersetzt.
wex_tsv() { printf '%s' "${1:-}" | tr '\t\r\n' '   '; }

# wiki_export [--out DIR] [--space <spaceId>] [--dry-run] [--prune|--no-prune] [--quiet]
# Exportiert alle (oder mit --space nur die eines Spaces) Docmost-Seiten als
# Markdown: eine Datei je Seite "<space-slug>__<page-slug>.md" mit YAML-Kopfzeile
# (title, space, spaceId, pageId). Idempotent ueber ein Manifest
# (.wiki-sync-manifest.tsv); im Wiki geloeschte Export-Dateien werden entfernt.
# Pruning ist schema-begrenzt: per Default werden nur Dateien im Export-Schema
# angefasst (fremde *.md im --out bleiben erhalten); aggressives Pruning ALLER
# nicht im Manifest stehenden *.md nur mit explizitem --prune; --no-prune
# deaktiviert das Pruning ganz (M1). Es werden keine Secrets ausgegeben; die
# Zugangsdaten stammen aus der teamctl-Konfiguration (TEAMCTL_WIKI_*).
# Default-Ziel: WIKI_EXPORT_DIR, sonst ~/.openclaw/wiki.
# Exit: 0 = vollstaendig, 1 = Fehler (unvollstaendig).
wiki_export() {
  local out="${WIKI_EXPORT_DIR:-$HOME/.openclaw/wiki}"
  local only_space="" dry=0 prune=1 aggressive=0 quiet=0
  while [ $# -gt 0 ]; do case "$1" in
    --out)      [ $# -ge 2 ] || die "wiki export: --out braucht einen Wert"; out="$2"; shift 2 ;;
    --space)    [ $# -ge 2 ] || die "wiki export: --space braucht einen Wert"; only_space="$2"; shift 2 ;;
    --dry-run)  dry=1; shift ;;
    --prune)    aggressive=1; shift ;;
    --no-prune) prune=0; shift ;;
    --quiet)    quiet=1; shift ;;
    *) die "wiki export: unbekannte Option '$1'" ;;
  esac; done

  local sleep_s="${TEAMCTL_WIKI_EXPORT_SLEEP:-0.2}"
  local manifest="$out/.wiki-sync-manifest.tsv"
  local tmp_manifest pages_tmp one_tmp file_tmp
  pages_tmp="$(mktmp)"; one_tmp="$(mktmp)"

  if [ "$dry" -eq 0 ]; then
    mkdir -p "$out" 2>/dev/null || die "wiki export: Zielverzeichnis nicht beschreibbar: $out"
  fi

  # N4: Temp-Dateien im ZIELVERZEICHNIS anlegen, damit das abschliessende mv
  # atomar bleibt (gleiches Dateisystem). Fehlt/schuetzt das Ziel (z. B.
  # --dry-run ohne vorhandenes --out), wird auf ein normales mktemp ausgewichen.
  if [ -d "$out" ] && [ -w "$out" ]; then
    tmp_manifest="$(mktemp "$out/.teamctl-wex-XXXXXX" 2>/dev/null)"
    file_tmp="$(mktemp "$out/.teamctl-wex-XXXXXX" 2>/dev/null)"
  fi
  [ -n "${tmp_manifest:-}" ] || tmp_manifest="$(mktmp)"
  [ -n "${file_tmp:-}" ] || file_tmp="$(mktmp)"
  TMPFILES+=("$pages_tmp" "$one_tmp" "$tmp_manifest" "$file_tmp")
  : > "$tmp_manifest"; : > "$pages_tmp"

  wiki_login "$WIKI_AS"
  wiki_api "spaces/" '{}' || die "wiki export: Spaces nicht lesbar (HTTP $WIKI_HTTP)"
  local spaces_tsv
  spaces_tsv="$(printf '%s' "$WIKI_BODY" | jq -r '.data.items[]? | [.id, (.slug // ""), (.name // "")] | @tsv' 2>/dev/null)"
  [ -n "$spaces_tsv" ] || die "wiki export: keine Spaces sichtbar"

  local n_spaces=0 n_pages=0 n_written=0 n_unchanged=0 n_removed=0 n_failed=0
  local sid sslug sname items exp_slug=""

  # 1) Seitenbaum aller Spaces abflachen -> spaceId<TAB>spaceSlug<TAB>pageId<TAB>title
  while IFS=$'\t' read -r sid sslug sname; do
    [ -n "$sid" ] || continue
    [ -z "$sslug" ] && sslug="$(wiki_slugify "${sname:-space}")"
    [ -z "$sslug" ] && sslug="$(wiki_slugify "$sid")"
    [ -z "$sslug" ] && sslug="space"
    if [ -n "$only_space" ] && [ "$sid" != "$only_space" ]; then continue; fi
    n_spaces=$((n_spaces + 1))
    exp_slug="$sslug"
    if ! wiki_fetch_sidebar "$sid" ""; then
      note "wiki export: Seitenbaum von Space '$sslug' nicht lesbar"
      n_failed=$((n_failed + 1)); continue
    fi
    items="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items' 2>/dev/null)"
    wiki_collect_pages "$sid" "$sslug" "$items" > "$one_tmp"
    while IFS=$'\t' read -r pslug pid ptitle; do
      [ -n "${pid:-}" ] || continue
      printf '%s\t%s\t%s\t%s\n' "$sid" "$pslug" "$pid" "$ptitle" >> "$pages_tmp"
    done < "$one_tmp"
    sleep "$sleep_s"
  done <<< "$spaces_tsv"

  if [ -n "$only_space" ] && [ "$n_spaces" -eq 0 ]; then
    die "wiki export: Space '$only_space' nicht gefunden"
  fi

  # 2) Inhalte holen und Dateien idempotent schreiben.
  local sid2 sslug2 pid ptitle pslug fname content body
  while IFS=$'\t' read -r sid2 sslug2 pid ptitle; do
    [ -n "${pid:-}" ] || continue
    n_pages=$((n_pages + 1))
    pslug="$(wiki_slugify "${ptitle:-page}")"; [ -z "$pslug" ] && pslug="page"
    fname="${sslug2}__${pslug}.md"
    if grep -qF "$fname"$'\t' "$tmp_manifest" 2>/dev/null; then
      fname="${sslug2}__${pslug}-${pid:0:8}.md"
    fi
    body="$(jq -nc --arg p "$pid" '{pageId:$p, format:"markdown", includeContent:true}')"
    if ! wiki_api "pages/info" "$body"; then
      note "wiki export: Inhalt von '$ptitle' ($pid) nicht lesbar (HTTP $WIKI_HTTP)"
      n_failed=$((n_failed + 1)); sleep "$sleep_s"; continue
    fi
    content="$(printf '%s' "$WIKI_BODY" | jq -r '.data.content // ""' 2>/dev/null)"

    {
      printf -- '---\n'
      printf 'title: "%s"\n' "$(wiki_yaml_escape "$ptitle")"
      printf 'space: "%s"\n' "$(wiki_yaml_escape "$sslug2")"
      printf 'spaceId: "%s"\n' "$(wiki_yaml_escape "$sid2")"
      printf 'pageId: "%s"\n' "$(wiki_yaml_escape "$pid")"
      printf -- '---\n\n# %s\n\n%s\n' "$ptitle" "$content"
    } > "$file_tmp"

    if [ -f "$out/$fname" ] && cmp -s "$file_tmp" "$out/$fname"; then
      n_unchanged=$((n_unchanged + 1))
      printf '%s\t%s\t%s\t%s\n' "$fname" "$pid" "$sslug2" "$(wex_tsv "$ptitle")" >> "$tmp_manifest"
    elif [ "$dry" -eq 1 ]; then
      wex_log "$quiet" "  ~ $fname (dry-run)"
      n_written=$((n_written + 1))
      printf '%s\t%s\t%s\t%s\n' "$fname" "$pid" "$sslug2" "$(wex_tsv "$ptitle")" >> "$tmp_manifest"
    elif mv "$file_tmp" "$out/$fname" 2>/dev/null; then
      wex_log "$quiet" "  ~ $fname"
      n_written=$((n_written + 1))
      printf '%s\t%s\t%s\t%s\n' "$fname" "$pid" "$sslug2" "$(wex_tsv "$ptitle")" >> "$tmp_manifest"
    else
      note "wiki export: Datei nicht schreibbar: $fname"
      n_failed=$((n_failed + 1))
    fi
    rm -f "$file_tmp"
    sleep "$sleep_s"
  done < "$pages_tmp"

  # Bei --space die Manifest-Zeilen der anderen Spaces erhalten.
  if [ "$dry" -eq 0 ] && [ -n "$only_space" ] && [ -f "$manifest" ]; then
    awk -F'\t' -v s="$exp_slug" 'NF>=3 && $3!=s' "$manifest" >> "$tmp_manifest"
  fi

  # 3) Pruning: im Wiki geloeschte Seiten aus dem Export entfernen.
  # Default: nur Dateien im Export-Schema (M1) - fremde *.md im --out bleiben
  # unangetastet. Erst explizites --prune entfernt ALLE nicht im Manifest
  # stehenden *.md (Altverhalten). --no-prune deaktiviert das Pruning ganz.
  if [ "$prune" -eq 1 ] && [ -d "$out" ]; then
    local base
    while IFS= read -r f; do
      base="$(basename "$f")"
      case "$base" in .*) continue ;; esac
      if [ "$aggressive" -eq 0 ] && ! wex_schema_file "$base"; then continue; fi
      if [ -n "$only_space" ]; then
        case "$base" in "${exp_slug}__"*) ;; *) continue ;; esac
      fi
      if ! grep -qF "$base"$'\t' "$tmp_manifest" 2>/dev/null; then
        if [ "$dry" -eq 1 ]; then
          wex_log "$quiet" "  - $base (dry-run)"
        else
          rm -f -- "$f" && wex_log "$quiet" "  - $base"
        fi
        n_removed=$((n_removed + 1))
      fi
    done < <(find "$out" -maxdepth 1 -type f -name '*.md' 2>/dev/null)
  fi

  # 4) Manifest atomar aktualisieren (nur bei echter Aenderung).
  if [ "$dry" -eq 0 ]; then
    if [ -f "$manifest" ] && cmp -s "$tmp_manifest" "$manifest"; then
      :
    else
      mv "$tmp_manifest" "$manifest"
    fi
  fi

  wex_log "$quiet" "wiki export: spaces=$n_spaces seiten=$n_pages geschrieben=$n_written unveraendert=$n_unchanged entfernt=$n_removed fehler=$n_failed"
  wex_log "$quiet" "wiki export: ziel=$out"
  if [ "$n_failed" -gt 0 ] || [ "$n_pages" -eq 0 ]; then
    note "wiki export: FEHLGESCHLAGEN - $n_failed Fehler, $n_pages Seiten"
    return 1
  fi
  return 0
}


wiki_cmd() {
  local args=() sub
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) [ $# -ge 2 ] || die "wiki: --as braucht einen Wert"; WIKI_AS="$2"; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  if [ "${#args[@]}" -gt 0 ]; then set -- "${args[@]}"; else set --; fi
  sub="${1:-}"; shift || true
  case "$sub" in
    spaces) wiki_spaces ;;
    pages)  wiki_pages "$@" ;;
    get)    wiki_get "$@" ;;
    search) wiki_search "$@" ;;
    create) wiki_create "$@" ;;
    update) wiki_update "$@" ;;
    upload) wiki_upload "$@" ;;
    export) wiki_export "$@" ;;
    me) wiki_me "$@" ;;
    profile) wiki_profile "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "wiki: unbekannter Unterbefehl (spaces|pages|get|search|create|update|upload|export)" ;;
  esac
}

# ---------------- Blog ----------------
BLOG_SLUG_RE='^[A-Za-z0-9._-]+$'

blog_list() {
  ssh_run "ls -1 -- '$BLOG_DIR/posts' 2>/dev/null | sed 's/[.]html$//'" || die "blog: Posts nicht lesbar ($BLOG_DIR/posts)"
}

# remote_mktmp <prefix> - erzeugt auf dem Zielhost eine eindeutige Tempdatei
# via mktemp und gibt deren Pfad aus (leer bei Fehler). N1: vorhersagbare
# Namen wie /tmp/teamctl_blog_$$.html sind eine Symlink-/Race-Falle.
remote_mktmp() {
  local p="${1:-teamctl}" out
  out="$(ssh_run "mktemp -p /tmp '${p}.XXXXXX'" 2>/dev/null)" || return 1
  out="$(printf '%s\n' "$out" | sed -n '1p')"
  case "$out" in
    /tmp/*|/var/tmp/*) printf '%s' "$out" ;;
    *) printf '' ;;
  esac
}

# remote_rm <pfad> - entfernt eine remote Tempdatei best-effort (nur /tmp-Pfade).
remote_rm() {
  local p="${1:-}"
  case "$p" in /tmp/*|/var/tmp/*) ssh_run "rm -f '$p'" >/dev/null 2>&1 || true ;; esac
  return 0
}

# blog_extract_title <datei> - liest den <title>-Text aus einer HTML-Datei,
# entfernt Tags, entschaerft Entities und normalisiert Leerraum (leer bei
# Fehler). Reines Lesen vom lokalen Dateisystem, keine Shell-Auswertung.
blog_extract_title() {
  local file="${1:-}" t=""
  [ -f "$file" ] || return 1
  t="$(python3 - "$file" <<'PY'
import re, sys, html
try:
    doc = open(sys.argv[1], encoding='utf-8', errors='replace').read()
except OSError:
    sys.exit(1)
m = re.search(r'<title[^>]*>(.*?)</title>', doc, re.IGNORECASE | re.DOTALL)
if not m:
    sys.exit(1)
t = re.sub('<[^>]+>', '', m.group(1))
t = html.unescape(t)
t = ' '.join(t.split())
if not t:
    sys.exit(1)
sys.stdout.write(t)
PY
)" || return 1
  [ -n "$t" ] || return 1
  printf '%s' "$t"
}

blog_publish() {
  local file="" slug="" title="" link=1 tmp out remote_size remote_hash local_size local_hash
  while [ $# -gt 0 ]; do case "$1" in
    --file) [ $# -ge 2 ] || die "blog publish: --file braucht einen Wert"; file="$2"; shift 2 ;;
    --slug) [ $# -ge 2 ] || die "blog publish: --slug braucht einen Wert"; slug="$2"; shift 2 ;;
    --title) [ $# -ge 2 ] || die "blog publish: --title braucht einen Wert"; title="$2"; shift 2 ;;
    --link) link=1; shift ;;
    --no-link) link=0; shift ;;
    *) die "blog publish: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$file" ] || die "blog publish: --file fehlt"
  [ -n "$slug" ] || die "blog publish: --slug fehlt"
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  [[ "$slug" =~ $BLOG_SLUG_RE ]] || die "blog publish: ungueltiger Slug '$slug'"
  tmp="$(remote_mktmp teamctl_blog)"
  [ -n "$tmp" ] || die "blog publish: keine remote Tempdatei (mktemp) erhalten"
  scp_to "$file" "$tmp" || { remote_rm "$tmp"; die "blog publish: scp fehlgeschlagen"; }
  # N3: nicht nur die Byte-Anzahl vergleichen (eine gleich grosse, falsche Datei
  # galt sonst als OK), sondern den sha256-Hash der ausgelieferten Datei.
  out="$(ssh_run "install -m 644 '$tmp' '$BLOG_DIR/posts/$slug.html' && rm -f '$tmp' && wc -c < '$BLOG_DIR/posts/$slug.html' && sha256sum '$BLOG_DIR/posts/$slug.html' | cut -d' ' -f1")" || die "blog publish: Deployment fehlgeschlagen"
  remote_size="$(printf '%s\n' "$out" | sed -n '1p' | tr -d '[:space:]')"
  remote_hash="$(printf '%s\n' "$out" | sed -n '2p' | tr -d '[:space:]')"
  local_size="$(wc -c < "$file" | tr -d '[:space:]')"
  local_hash="$(sha256sum "$file" | cut -d' ' -f1)"
  [ -n "$remote_hash" ] || die "blog publish: Verifikation fehlgeschlagen (kein sha256 von remote)"
  [ "$remote_hash" = "$local_hash" ] || die "blog publish: Verifikation fehlgeschlagen (sha256 remote=$remote_hash lokal=$local_hash)"
  [ "$remote_size" = "$local_size" ] || die "blog publish: Verifikation fehlgeschlagen (remote=$remote_size lokal=$local_size)"
  printf 'OK\t/posts/%s.html\t%s\n' "$slug" "$remote_size"
  # Index-Einhaengung (Default): ohne Eintrag in index.html ist der Post nur per
  # Direkt-URL erreichbar - daher nach dem Publish standardmaessig verlinken.
  if [ "$link" -eq 0 ]; then
    note "blog publish: --no-link - Index-Einhaengung uebersprungen."
    note "blog publish: Post '$slug' ist NICHT in der Indexseite verlinkt. Nachziehen mit: teamctl blog link --title '<Titel>' --slug $slug"
    return 0
  fi
  if [ -z "$title" ]; then
    title="$(blog_extract_title "$file" || true)"
  fi
  if [ -z "$title" ]; then
    die "blog publish: Post '$slug' wurde veroeffentlicht, aber kein Titel gefunden (weder --title noch <title> in '$file'). Index-Einhaengung FEHLT. Nachziehen mit: teamctl blog link --title '<Titel>' --slug $slug"
  fi
  local ln_out
  if ln_out="$(blog_link --title "$title" --slug "$slug" 2>&1)"; then
    printf '%s\n' "$ln_out"
    note "blog publish: Index-Einhaengung fuer '$slug' verifiziert (Read-back)."
  else
    printf '%s\n' "$ln_out" >&2
    die "blog publish: Post '$slug' ist veroeffentlicht, aber die Index-Einhaengung ist FEHLGESCHLAGEN. Nachziehen mit: teamctl blog link --title '$title' --slug $slug"
  fi
}

blog_link() {
  local title="" slug="" tmp before=0 after=0 remote_tmp
  while [ $# -gt 0 ]; do case "$1" in
    --title) [ $# -ge 2 ] || die "blog link: --title braucht einen Wert"; title="$2"; shift 2 ;;
    --slug)  [ $# -ge 2 ] || die "blog link: --slug braucht einen Wert"; slug="$2"; shift 2 ;;
    *) die "blog link: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$title" ] || die "blog link: --title fehlt"
  [ -n "$slug" ] || die "blog link: --slug fehlt"
  [[ "$slug" =~ $BLOG_SLUG_RE ]] || die "blog link: ungueltiger Slug '$slug'"
  tmp="$(mktmp)"
  scp_from "$BLOG_DIR/index.html" "$tmp" || die "blog link: index.html nicht lesbar"
  if grep -qF "href=\"/posts/$slug.html\"" "$tmp"; then
    note "Link fuer '$slug' existiert bereits - keine Aenderung"
    printf 'SKIP\t%s\n' "$slug"
    return 0
  fi
  before="$(grep -c 'href="/posts/' "$tmp" || true)"
  python3 - "$tmp" "$slug" "$title" <<'PY' || die "blog link: index.html Bearbeitung fehlgeschlagen"
import sys, io, html
path, slug, title = sys.argv[1], sys.argv[2], sys.argv[3]
doc = io.open(path, encoding='utf-8').read()
item = '    <li><a href="/posts/%s.html">%s</a></li>\n' % (slug, html.escape(title))
i = doc.rfind('</ul>')
if i == -1:
    sys.stderr.write('kein </ul> in index.html gefunden\n'); sys.exit(1)
io.open(path, 'w', encoding='utf-8').write(doc[:i] + item + doc[i:])
PY
  remote_tmp="$(remote_mktmp teamctl_index)"
  [ -n "$remote_tmp" ] || die "blog link: keine remote Tempdatei (mktemp) erhalten"
  scp_to "$tmp" "$remote_tmp" || { remote_rm "$remote_tmp"; die "blog link: scp fehlgeschlagen"; }
  ssh_run "install -m 644 '$remote_tmp' '$BLOG_DIR/index.html' && rm -f '$remote_tmp'" || die "blog link: Deployment fehlgeschlagen"
  after="$(ssh_run "grep -c 'href=\"/posts/' '$BLOG_DIR/index.html'" || true)"
  [ "$after" -eq "$((before + 1))" ] || die "blog link: Verifikation fehlgeschlagen (vorher=$before nachher=$after)"
  ssh_run "grep -q 'href=\"/posts/$slug.html\"' '$BLOG_DIR/index.html'" || die "blog link: Slug nicht in index.html gefunden"
  printf 'OK\t%s\tlinks=%s\n' "$slug" "$after"
}

blog_cmd() {
  local sub; sub="${1:-}"; shift || true
  case "$sub" in
    list) blog_list ;;
    publish) blog_publish "$@" ;;
    link) blog_link "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "blog: unbekannter Unterbefehl (list|publish|link)" ;;
  esac
}

# ---------------- Git (GitHub) ----------------
GIT_REPO_RE='^[A-Za-z0-9._-]+$'

# Repo-Namen pruefen: erlaubte Zeichen UND keine relativen Pfad-Aliase.
# "." und ".." passen auf ^[A-Za-z0-9._-]+$ und wuerden sonst in API-Pfade
# wie /repos/$GITHUB_OWNER/../... gelangen - daher explizit ablehnen.
git_repo_ok() {
  local name="$1"
  [[ "$name" =~ $GIT_REPO_RE ]] || return 1
  case "$name" in .|..) return 1 ;; esac
  return 0
}

# Datei-/Verzeichnispfade pruefen: leere Pfade, "." und ".." sowie absolute
# Pfade (fuehrendes "/") ablehnen, damit keine API-Pfade wie
# /repos/$GITHUB_OWNER/$repo/contents/../... entstehen.
git_path_ok() {
  local p="$1" seg
  local -a segs
  [ -n "$p" ] || return 1
  case "$p" in /*|*/) return 1 ;; esac
  # N2: nicht nur "."/".." als Ganzes ablehnen, sondern JEDES Pfadsegment
  # (auch "a/../b", "a/./b", leere Segmente durch "//"); End-Slash ist oben
  # bereits abgewiesen.
  local IFS=/
  read -ra segs <<< "$p" || return 1
  for seg in "${segs[@]}"; do
    case "$seg" in
      ""|.|..) return 1 ;;
    esac
  done
  return 0
}

# Kodiert ein Pfadsegment bzw. einen Branch-Namen fuer die GitHub-Contents-API
# (RFC-3986, jq @uri). Gemeinsamer Helper fuer git_list/git_upload/git_read,
# damit Pfade mit Leerzeichen, #, ?, &, % nicht falsch interpretiert werden.
git_uri_enc() { jq -rn --arg v "$1" '$v|@uri' || die "git: Pfad nicht kodierbar"; }

git_require_repo() {
  local who="$1" name="$2"
  git_repo_ok "$name" || die "$who: ungueltiger Repo-Name '$name'"
}

# Loest ein Repo-Argument in Owner und Repo auf und validiert beide Teile.
# Erlaubt "<repo>" (Owner = $GITHUB_OWNER, bisheriges Verhalten) und
# "<owner>/<repo>" fuer ein fremdes Repo. Setzt die globalen Variablen
# GIT_OWNER und GIT_REPO. Bei "owner/repo" werden BEIDE Teile mit git_repo_ok
# geprueft (lehnt leere Teile, ".", "..", zusaetzliche Slashes und Sonderzeichen
# ab, damit keine Pfad-Traversal-API-Pfade entstehen).
git_owner_repo() {
  local who="$1" arg="$2"
  case "$arg" in
    */*)
      local owner="${arg%%/*}" repo="${arg#*/}"
      git_repo_ok "$owner" || die "$who: ungueltiger Owner-Name '$owner'"
      git_repo_ok "$repo"  || die "$who: ungueltiger Repo-Name '$repo'"
      GIT_OWNER="$owner"; GIT_REPO="$repo"
      ;;
    *)
      git_require_repo "$who" "$arg"
      GIT_OWNER="$GITHUB_OWNER"; GIT_REPO="$arg"
      ;;
  esac
}

git_token() {
  # Injektionssicher: KEIN eval, keine Shell-Expansion des Werts. Der Befehl
  # wird als einfache Wortliste ausgefuehrt (word splitting) - der Wert wird
  # nie von einer Shell geparst. Erlaubt sind nur harmlose Zeichen; alles
  # andere (u. a. ; $ ` | > < & neue Zeilen) wird abgelehnt.
  # Meldungen nennen nur den Schluesselnamen TEAMCTL_GITHUB_TOKEN_CMD - nie
  # den Wert/das Kommando.
  local -a cmd
  # Leerzeichen sind erlaubt (Worttrennung) und werden vor der Pruefung
  # entfernt - so enthaelt die Zeichenklasse kein Leerzeichen und bleibt
  # eindeutig (Bindestrich als letztes Zeichen = literal).
  local _probe="${GITHUB_TOKEN_CMD// /}"
  case "$_probe" in
    *[!A-Za-z0-9_./-]*)
      die "git: TEAMCTL_GITHUB_TOKEN_CMD enthaelt unerlaubte Zeichen (erlaubt: A-Z a-z 0-9 _ . / - und Leerzeichen)" ;;
  esac
  unset _probe
  IFS=' ' read -r -a cmd <<< "$GITHUB_TOKEN_CMD"
  [ "${#cmd[@]}" -gt 0 ] || die "git: TEAMCTL_GITHUB_TOKEN_CMD ist leer"
  local t
  t="$("${cmd[@]}" 2>/dev/null)" || die "git: Token nicht lesbar (TEAMCTL_GITHUB_TOKEN_CMD)"
  [ -n "$t" ] || die "git: Token leer"
  printf '%s' "$t"
}

gh_api() {
  local method="$1" path="$2" data="$3" f
  f="$(mktmp)"
  local args=(-sS --max-time 60 -X "$method" \
    -H "Authorization: Bearer $TOK" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    -H "User-Agent: teamctl")
  if [ -n "$data" ]; then args+=(--data-binary "$data"); fi
  GH_HTTP="$(curl "${args[@]}" -o "$f" -w '%{http_code}' "$GITHUB_API$path")"
  GH_BODY="$(cat "$f")"
  case "$GH_HTTP" in 200|201) return 0 ;; *) return 1 ;; esac
}

git_err() { printf '%s' "$GH_BODY" | jq -r '.message // empty' 2>/dev/null | head -1; }

# git_expect_array <kontext>
# Gemeinsamer Helper fuer die listen-artigen git_*-Funktionen: bricht ab
# (Meldung auf stderr, Exit 1), wenn GH_BODY leer oder kein JSON-Array ist.
# Vorher gaben manche Funktionen bei einem GitHub-Fehlerobjekt (.message)
# Text auf STDOUT aus und endeten mit exit 0 (stiller Erfolg) - jetzt ist das
# ein harter Fehler. Die Ausgabe im Array-Fall bleibt unveraendert.
git_expect_array() {
  local who="$1"
  [ -n "$GH_BODY" ] || die "$who: leere API-Antwort"
  printf '%s' "$GH_BODY" | jq -e 'type=="array"' >/dev/null 2>&1 || die "$who: unerwartete API-Antwort: $(git_err)"
}

git_repos() {
  gh_api GET "/user/repos?per_page=100&sort=full_name" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git repos"
  printf '%s' "$GH_BODY" | jq -r '.[] | [.name, (if .private then "private" else "public" end), .default_branch, .pushed_at, .html_url] | @tsv'
}

git_info() {
  [ $# -ge 1 ] || die "git info: <repo> fehlt"
  local repo="$1"
  git_require_repo "git info" "$repo"
  gh_api GET "/repos/$GITHUB_OWNER/$repo" "" || die "HTTP $GH_HTTP: $(git_err)"
  printf '%s' "$GH_BODY" | jq -r '"full_name\t\(.full_name)", "private\t\(.private)", "default_branch\t\(.default_branch)", "description\t\(.description // "")", "html_url\t\(.html_url)", "size_kb\t\(.size)"'
}

# git_branches <repo>
# Listet die Branches eines Repos (read-only) TAB-getrennt:
#   name<TAB>sha(kurz, 7 Zeichen)<TAB>protected(true|false)
# Sortiert nach name (jq sort_by(.name)).
git_branches() {
  [ $# -ge 1 ] || die "git branches: <repo> fehlt"
  local repo="$1"
  git_require_repo "git branches" "$repo"
  gh_api GET "/repos/$GITHUB_OWNER/$repo/branches?per_page=100" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git branches"
  printf '%s' "$GH_BODY" | jq -r 'sort_by(.name)[] | [.name, (.commit.sha[0:7]), ((.protected // false)|tostring)] | @tsv'
}

# git_commits <repo> [--n <anzahl>]
# Listet die letzten Commits eines Repos (read-only) TAB-getrennt:
#   sha(kurz, 7)<TAB>iso-datum<TAB>author-login<TAB>nachricht (erste Zeile)
# Option --n: Anzahl 1..100 (Default 10).
git_commits() {
  [ $# -ge 1 ] || die "git commits: <repo> fehlt"
  local repo="$1"; shift
  local n=10
  while [ $# -gt 0 ]; do case "$1" in
    --n) [ $# -ge 2 ] || die "git commits: --n braucht einen Wert"; n="$2"; shift 2 ;;
    *) die "git commits: unbekannte Option '$1'" ;;
  esac; done
  git_require_repo "git commits" "$repo"
  [[ "$n" =~ ^[0-9]{1,3}$ ]] || die "git commits: ungueltiges --n '$n' (Ganzzahl 1..100)"
  n=$((10#$n))
  if [ "$n" -lt 1 ] || [ "$n" -gt 100 ]; then
    die "git commits: --n ausserhalb 1..100 ('$n')"
  fi
  gh_api GET "/repos/$GITHUB_OWNER/$repo/commits?per_page=$n" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git commits"
  printf '%s' "$GH_BODY" | jq -r '
    .[] | [
      (.sha[0:7]),
      (.commit.author.date // ""),
      (.author.login // .commit.author.name // ""),
      ((.commit.message // "") | split("\n")[0] | gsub("\t"; " ") | gsub("[\r\n]"; " "))
    ] | @tsv'
}

git_list() {
  [ $# -ge 1 ] || die "git list: <repo> fehlt"
  local repo="$1" dir="" path dir_enc
  git_require_repo "git list" "$repo"
  if [ $# -ge 2 ]; then dir="$2"; fi
  path="/repos/$GITHUB_OWNER/$repo/contents"
  if [ -n "$dir" ]; then
    git_path_ok "$dir" || die "git list: ungueltiger Pfad '$dir'"
    dir_enc="$(git_uri_enc "$dir")" || die "git list: Verzeichnis nicht kodierbar"
    path="$path/$dir_enc"
  fi
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git list"
  printf '%s' "$GH_BODY" | jq -r '.[] | [.type, (.size|tostring), .path] | @tsv'
}

git_create_repo() {
  local name="" public=false body
  while [ $# -gt 0 ]; do case "$1" in
    --public)  public=true; shift ;;
    --private) public=false; shift ;;
    -*) die "git create-repo: unbekannte Option '$1'" ;;
    *) name="$1"; shift ;;
  esac; done
  [ -n "$name" ] || die "git create-repo: <name> fehlt"
  body="$(jq -nc --arg n "$name" --argjson p "$public" '{name:$n, private:($p|not), auto_init:true}')"
  gh_api POST "/user/repos" "$body" || die "HTTP $GH_HTTP: $(git_err)"
  printf '%s' "$GH_BODY" | jq -r '[.full_name, ("private=" + (.private|tostring)), .html_url] | @tsv'
}

# Schreibt eine Datei ins Repo.
# Standardpfad ist die Contents-API (mode 100644). Fuer ausfuehrbare lokale
# Dateien (mode +x) wird die Datei ueber die Git-Data-API geschrieben
# (blob -> tree mit mode 100755 -> commit -> ref), weil die Contents-API
# regulaere Dateien IMMER als 100644 speichert und das Executable-Bit damit
# verloren geht. Optionen: --message <m>, --exec (100755 erzwingen),
# --no-exec (100644 erzwingen).
git_upload() {
  [ $# -ge 3 ] || die "git upload: <repo> <pfad> <lokale-datei> fehlt"
  local repo="$1" path="$2" file="$3"; shift 3
  git_require_repo "git upload" "$repo"
  git_path_ok "$path" || die "git upload: ungueltiger Pfad '$path'"
  local msg="teamctl: update $path" mode=""
  while [ $# -gt 0 ]; do case "$1" in
    --message) [ $# -ge 2 ] || die "git upload: --message braucht einen Wert"; msg="$2"; shift 2 ;;
    --exec)    mode="100755"; shift ;;
    --no-exec) mode="100644"; shift ;;
    *) die "git upload: unbekannte Option '$1'" ;;
  esac; done
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  # Mode-Auswahl: explizite Option gewinnt, sonst lokaler Ausfuehrbar-Bit.
  if [ -z "$mode" ]; then
    if [ -x "$file" ]; then mode="100755"; else mode="100644"; fi
  fi
  if [ "$mode" = "100755" ]; then
    git_upload_exec "$repo" "$path" "$file" "$msg"
  else
    git_upload_plain "$repo" "$path" "$file" "$msg"
  fi
}

# git_upload_plain <repo> <pfad> <lokale-datei> <msg>
# Contents-API-Weg (mode 100644): create/update per PUT /contents, danach
# Read-back von sha und Groesse. Unveraendertes Altverhalten.
git_upload_plain() {
  local repo="$1" path="$2" file="$3" msg="$4"
  local enc sha="" body newsha rsha rsize lsize b64
  enc="$(git_uri_enc "$path")" || die "git upload: Pfad nicht kodierbar"
  b64="$(base64 -w0 "$file")"
  if gh_api GET "/repos/$GITHUB_OWNER/$repo/contents/$enc" "" 2>/dev/null; then
    sha="$(printf '%s' "$GH_BODY" | jq -r '.sha // empty')"
  fi
  if [ -n "$sha" ]; then
    body="$(jq -nc --arg m "$msg" --arg c "$b64" --arg s "$sha" '{message:$m,content:$c,sha:$s}')"
    note "Datei existiert bereits - wird aktualisiert"
  else
    body="$(jq -nc --arg m "$msg" --arg c "$b64" '{message:$m,content:$c}')"
  fi
  gh_api PUT "/repos/$GITHUB_OWNER/$repo/contents/$enc" "$body" || die "HTTP $GH_HTTP: $(git_err)"
  newsha="$(printf '%s' "$GH_BODY" | jq -r '.content.sha // empty')"
  gh_api GET "/repos/$GITHUB_OWNER/$repo/contents/$enc" "" || die "Read-back HTTP $GH_HTTP: $(git_err)"
  rsha="$(printf '%s' "$GH_BODY" | jq -r '.sha')"
  rsize="$(printf '%s' "$GH_BODY" | jq -r '.size')"
  lsize="$(wc -c < "$file" | tr -d '[:space:]')"
  [ "$rsize" = "$lsize" ] || die "git upload: Verifikation fehlgeschlagen (remote=$rsize lokal=$lsize)"
  if [ -n "$newsha" ]; then
    [ "$rsha" = "$newsha" ] || die "git upload: Verifikation fehlgeschlagen (sha remote=$rsha neu=$newsha)"
  fi
  printf 'OK\t%s/%s\t%s\t%s\n' "$GITHUB_OWNER" "$repo" "$path" "$rsha"
}

# git_upload_exec <repo> <pfad> <lokale-datei> <msg>
# Git-Data-API-Weg mit mode 100755 - erhaelt das Executable-Bit:
#   GET repo -> GET ref/heads/<b> -> GET commit -> GET tree (base_tree)
#   POST blob (base64) -> POST tree (base_tree + Eintrag mode 100755)
#   POST commit (parents=[head]) -> PATCH refs/heads/<b>
# Read-back ueber den Tree des neuen Commits: Mode UND Blob-SHA muessen passen
# (der Blob-SHA belegt den exakten Inhalt).
git_upload_exec() {
  local repo="$1" path="$2" file="$3" msg="$4"
  local branch benc head base_tree b64 body blob tree commit rmode rsha
  gh_api GET "/repos/$GITHUB_OWNER/$repo" "" || die "HTTP $GH_HTTP: $(git_err)"
  branch="$(printf '%s' "$GH_BODY" | jq -r '.default_branch // empty')"
  [ -n "$branch" ] || die "git upload: Default-Branch nicht ermittelbar"
  benc="$(git_uri_enc "$branch")" || die "git upload: Branch nicht kodierbar"
  gh_api GET "/repos/$GITHUB_OWNER/$repo/git/ref/heads/$benc" "" || die "HTTP $GH_HTTP: $(git_err)"
  head="$(printf '%s' "$GH_BODY" | jq -r '.object.sha // empty')"
  [ -n "$head" ] || die "git upload: HEAD von '$branch' nicht ermittelbar"
  gh_api GET "/repos/$GITHUB_OWNER/$repo/git/commits/$head" "" || die "HTTP $GH_HTTP: $(git_err)"
  base_tree="$(printf '%s' "$GH_BODY" | jq -r '.tree.sha // empty')"
  [ -n "$base_tree" ] || die "git upload: Basis-Tree nicht ermittelbar"
  b64="$(base64 -w0 "$file")"
  body="$(jq -nc --arg c "$b64" '{content:$c,encoding:"base64"}')"
  gh_api POST "/repos/$GITHUB_OWNER/$repo/git/blobs" "$body" || die "HTTP $GH_HTTP: $(git_err)"
  blob="$(printf '%s' "$GH_BODY" | jq -r '.sha // empty')"
  [ -n "$blob" ] || die "git upload: Blob-SHA nicht ermittelbar"
  body="$(jq -nc --arg t "$base_tree" --arg p "$path" --arg s "$blob" \
    '{base_tree:$t,tree:[{path:$p,mode:"100755",type:"blob",sha:$s}]}')"
  gh_api POST "/repos/$GITHUB_OWNER/$repo/git/trees" "$body" || die "HTTP $GH_HTTP: $(git_err)"
  tree="$(printf '%s' "$GH_BODY" | jq -r '.sha // empty')"
  [ -n "$tree" ] || die "git upload: Tree-SHA nicht ermittelbar"
  body="$(jq -nc --arg m "$msg" --arg t "$tree" --arg p "$head" '{message:$m,tree:$t,parents:[$p]}')"
  gh_api POST "/repos/$GITHUB_OWNER/$repo/git/commits" "$body" || die "HTTP $GH_HTTP: $(git_err)"
  commit="$(printf '%s' "$GH_BODY" | jq -r '.sha // empty')"
  [ -n "$commit" ] || die "git upload: Commit-SHA nicht ermittelbar"
  body="$(jq -nc --arg s "$commit" '{sha:$s}')"
  gh_api PATCH "/repos/$GITHUB_OWNER/$repo/git/refs/heads/$benc" "$body" || die "HTTP $GH_HTTP: $(git_err)"
  gh_api GET "/repos/$GITHUB_OWNER/$repo/git/trees/$commit?recursive=1" "" || die "Read-back HTTP $GH_HTTP: $(git_err)"
  printf '%s' "$GH_BODY" | jq -e '.truncated != true' >/dev/null 2>&1 || die "git upload: Read-back-Tree abgeschnitten"
  rmode="$(printf '%s' "$GH_BODY" | jq -r --arg p "$path" '.tree[] | select(.path==$p) | .mode' | head -1)"
  rsha="$(printf '%s' "$GH_BODY" | jq -r --arg p "$path" '.tree[] | select(.path==$p) | .sha' | head -1)"
  [ "$rmode" = "100755" ] || die "git upload: Verifikation fehlgeschlagen (mode=${rmode:-?}, erwartet 100755)"
  [ "$rsha" = "$blob" ] || die "git upload: Verifikation fehlgeschlagen (sha remote=$rsha blob=$blob)"
  note "mode 100755 via Git-Data-API gesetzt"
  printf 'OK\t%s/%s\t%s\t%s\n' "$GITHUB_OWNER" "$repo" "$path" "$rsha"
}

# git_read <repo> <pfad> [--ref <branch>]   (Alias: git cat)
# Liest eine Textdatei ueber die GitHub-Contents-API. Der Aufrufer braucht weder
# Token noch URL; das Token bleibt intern und wird nie ausgegeben.
git_read() {
  [ $# -ge 2 ] || die "git read: <repo> <pfad> fehlt"
  local repo="$1" path="$2"; shift 2
  local ref="" enc renc api type size content
  while [ $# -gt 0 ]; do case "$1" in
    --ref) [ $# -ge 2 ] || die "git read: --ref braucht einen Wert"; ref="$2"; shift 2 ;;
    *) die "git read: unbekannte Option '$1'" ;;
  esac; done
  git_require_repo "git read" "$repo"
  [ -n "$path" ] || die "git read: <pfad> fehlt"
  git_path_ok "$path" || die "git read: ungueltiger Pfad '$path'"
  enc="$(git_uri_enc "$path")" || die "git read: Pfad nicht kodierbar"
  api="/repos/$GITHUB_OWNER/$repo/contents/$enc"
  if [ -n "$ref" ]; then
    renc="$(git_uri_enc "$ref")" || die "git read: Branch nicht kodierbar"
    api="$api?ref=$renc"
  fi
  gh_api GET "$api" "" || die "HTTP $GH_HTTP: $(git_err)"
  type="$(printf '%s' "$GH_BODY" | jq -r 'if type=="object" then (.type // "") else "array" end')"
  [ "$type" = "file" ] || die "git read: '$path' ist in $repo keine regulaere Datei (type='${type:-?}')"
  size="$(printf '%s' "$GH_BODY" | jq -r '.size // 0')"
  if [ "${size:-0}" -gt 1000000 ] 2>/dev/null; then
    die "git read: Datei zu gross fuer die Contents-API (${size} Bytes) - stattdessen 'teamctl git clone' nutzen"
  fi
  content="$(printf '%s' "$GH_BODY" | jq -r '.content // "" | gsub("[\\r\\n]"; "") | @base64d')" \
    || die "git read: Inhalt nicht dekodierbar (binaere Datei?)"
  printf '%s\n' "$content"
}

# git_clone <repo> [--dir <ziel>] [--branch <b>]
# Klont ein Team-Repo per HTTPS. Das Token wird ausschliesslich intern als
# HTTP-Header uebergeben (nicht in URL, Kommandozeile oder Ausgabe) und NICHT
# im geklonten Repo gespeichert.
git_clone() {
  [ $# -ge 1 ] || die "git clone: <repo> fehlt"
  local repo="" dir="" branch=""
  while [ $# -gt 0 ]; do case "$1" in
    --dir) [ $# -ge 2 ] || die "git clone: --dir braucht einen Wert"; dir="$2"; shift 2 ;;
    --branch) [ $# -ge 2 ] || die "git clone: --branch braucht einen Wert"; branch="$2"; shift 2 ;;
    -*) die "git clone: unbekannte Option '$1'" ;;
    *) if [ -z "$repo" ]; then repo="$1";
       elif [ -z "$dir" ]; then dir="$1";
       else die "git clone: zu viele Argumente ('$1')"; fi
       shift ;;
  esac; done
  git_require_repo "git clone" "$repo"
  [ -n "$dir" ] || dir="$repo"
  [ -e "$dir" ] && die "git clone: Ziel existiert bereits: $dir"
  local url="https://github.com/$GITHUB_OWNER/$repo.git" hdr ef sha br n
  local args=(--quiet)
  [ -n "$branch" ] && args+=(--branch "$branch")
  hdr="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOK" | base64 -w0)"
  ef="$(mktmp)"
  if ! GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=1 \
       GIT_CONFIG_KEY_0=http.extraHeader GIT_CONFIG_VALUE_0="$hdr" \
       git clone "${args[@]}" "$url" "$dir" >/dev/null 2>"$ef"; then
    sed -n '1,5p' "$ef" >&2
    die "git clone $GITHUB_OWNER/$repo fehlgeschlagen (Ziel: $dir)"
  fi
  sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  br="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  n="$(git -C "$dir" ls-files 2>/dev/null | wc -l | tr -d '[:space:]')"
  note "geklont: $GITHUB_OWNER/$repo -> $dir"
  printf 'OK\t%s/%s\t%s\t%s\t%s\t%s\n' "$GITHUB_OWNER" "$repo" "$dir" "$br" "$sha" "$n"
}

# git_pull <dir>
# Aktualisiert ein zuvor geklontes Repo (nur fast-forward). Token wie bei clone
# ausschliesslich intern; im Repo selbst werden keine Credentials abgelegt.
git_pull() {
  [ $# -ge 1 ] || die "git pull: <dir> fehlt"
  local dir="$1" old new br hdr ef
  [ -d "$dir/.git" ] || die "git pull: kein Git-Repository: $dir"
  old="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  br="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  hdr="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOK" | base64 -w0)"
  ef="$(mktmp)"
  if ! GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=1 \
       GIT_CONFIG_KEY_0=http.extraHeader GIT_CONFIG_VALUE_0="$hdr" \
       git -C "$dir" pull --ff-only --quiet >/dev/null 2>"$ef"; then
    sed -n '1,5p' "$ef" >&2
    die "git pull fehlgeschlagen in $dir"
  fi
  new="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  if [ "$old" = "$new" ]; then
    printf 'OK\t%s\t%s\t%s\tunveraendert\n' "$dir" "$br" "$new"
  else
    printf 'OK\t%s\t%s\t%s..%s\taktualisiert\n' "$dir" "$br" "$old" "$new"
  fi
}

# git_status <dir>
# Zeigt den Arbeitsbaum-Status eines zuvor geklonten Repos (read-only, kein
# Netz, kein Token): Branch, kurzer SHA, Voraus/Hinterher zum Upstream sowie
# Anzahl geaenderter und ungetrackter Dateien. Ausgabe TAB-getrennt;
# Voraus/Hinterher sind '-' wenn kein Upstream gesetzt ist.
git_status() {
  [ $# -ge 1 ] || die "git status: <dir> fehlt"
  local dir="$1"
  [ -d "$dir/.git" ] || die "git status: kein Git-Repository: $dir"
  local branch sha ahead behind changed untracked
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  ahead="-" behind="-"
  if git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    ahead="$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null)"
    behind="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null)"
  fi
  changed="$(git -C "$dir" status --porcelain 2>/dev/null | awk 'NF{n++} END{print n+0}')"
  untracked="$(git -C "$dir" status --porcelain 2>/dev/null | awk '/^\?\?/{n++} END{print n+0}')"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$branch" "$sha" "$ahead" "$behind" "$changed" "$untracked"
}

# git_author_ok <title> <body>
# Prueft die Ersteller-Kennung der Konvention: der Body beginnt mit
# "Ersteller:" (gefolgt von "Datum: <YYYY-MM-DD>"). Der Titel ist ein normaler
# Kurztitel OHNE Praefix - die Agent-Kennung steht NUR im Body (N6: frueher
# wurde zusaetzlich das Titel-Praefix "[<agent-id>]" verlangt, wodurch jede
# konventionsgerechte Anlage eine WARNUNG erzeugte).
# Quelle der Konvention: Wiki "Team & Koordination" -> "Richtlinien & Vorgaben".
# Rueckgabe: 0 = Kennung im Body vorhanden, 1 = fehlt.
git_author_ok() {
  local body="$2"
  case "$body" in "Ersteller:"*) ;; *) return 1 ;; esac
  return 0
}

# git_author_hint - Konventionshinweis auf stderr.
# Nennt nur Platzhalter/Schluesselnamen (keine Secrets, keine Infra-Werte).
git_author_hint() {
  printf 'teamctl: Konvention: Titel als normaler Kurztitel OHNE Praefix; Body-Beginn "Ersteller: <agent-id>" und "Datum: <YYYY-MM-DD>".\n' >&2
  printf 'teamctl: Quelle: Wiki "Team & Koordination" -> "Richtlinien & Vorgaben".\n' >&2
}

git_issue() {
  [ $# -ge 1 ] || die "git issue: <repo> fehlt"
  local repo="$1"; shift
  local title="" body="" file="" label="" payload num url state
  local require_author=0 author=""
  while [ $# -gt 0 ]; do case "$1" in
    --title) [ $# -ge 2 ] || die "git issue: --title braucht einen Wert"; title="$2"; shift 2 ;;
    --body)  [ $# -ge 2 ] || die "git issue: --body braucht einen Wert"; body="$2"; shift 2 ;;
    --file)  [ $# -ge 2 ] || die "git issue: --file braucht einen Wert"; file="$2"; shift 2 ;;
    --label) [ $# -ge 2 ] || die "git issue: --label braucht einen Wert"; label="$2"; shift 2 ;;
    --author) [ $# -ge 2 ] || die "git issue: --author braucht einen Wert"; author="$2"; shift 2 ;;
    --require-author) require_author=1; shift ;;
    *) die "git issue: unbekannte Option '$1'" ;;
  esac; done
  git_owner_repo "git issue" "$repo"
  [ -n "$title" ] || die "git issue: --title fehlt"
  if [ -n "$file" ] && [ -n "$body" ]; then die "git issue: --body und --file nicht gleichzeitig"; fi
  if [ -n "$file" ]; then
    [ -f "$file" ] || die "Datei nicht gefunden: $file"
    body="$(cat "$file")"
  fi
  [ -n "$body" ] || die "git issue: --body oder --file fehlt (Text des Wunsches)"
  # Optionales Hilfsflag --author: Kennung automatisch setzen.
  # Konvention (N6): die Agent-Kennung steht NUR im Body - der Titel bleibt ein
  # normaler Kurztitel OHNE Praefix. Body-Beginn "Ersteller: <agent-id>" +
  # "Datum: <YYYY-MM-DD>" nur, wenn der Body nicht schon mit "Ersteller:"
  # beginnt (idempotent).
  if [ -n "$author" ]; then
    case "$body" in
      "Ersteller:"*) ;;
      *) body="Ersteller: $author
Datum: $(date -u +%Y-%m-%d)
$body" ;;
    esac
  fi
  # Ersteller-Kennung pruefen (Konvention: Wiki "Team & Koordination"
  # -> "Richtlinien & Vorgaben"). Standard: nur Warnung auf stderr, Exit 0.
  # Mit --require-author: harter Abbruch VOR jedem API-Aufruf (kein Issue).
  if ! git_author_ok "$title" "$body"; then
    if [ "$require_author" = "1" ]; then
      printf 'teamctl: FEHLER: git issue: Ersteller-Kennung fehlt/unvollstaendig (--require-author) - kein Issue angelegt.\n' >&2
      git_author_hint
      printf 'teamctl: Abhilfe: Titel/Body anpassen oder --author <agent-id> verwenden.\n' >&2
      exit 1
    fi
    printf 'teamctl: WARNUNG: git issue: Ersteller-Kennung unvollstaendig - Issue wird trotzdem angelegt (strikt: --require-author).\n' >&2
    git_author_hint
  fi
  if [ -n "$label" ]; then
    payload="$(jq -nc --arg t "$title" --arg b "$body" --arg l "$label" '{title:$t, body:$b, labels:($l|split(","))}')"
  else
    payload="$(jq -nc --arg t "$title" --arg b "$body" '{title:$t, body:$b}')"
  fi
  gh_api POST "/repos/$GIT_OWNER/$GIT_REPO/issues" "$payload" || die "HTTP $GH_HTTP: $(git_err)"
  note "POST issues: HTTP $GH_HTTP"
  num="$(printf '%s' "$GH_BODY" | jq -r '.number // empty')"
  url="$(printf '%s' "$GH_BODY" | jq -r '.html_url // empty')"
  [ -n "$num" ] || die "git issue: keine Issue-Nummer in der Antwort"
  gh_api GET "/repos/$GIT_OWNER/$GIT_REPO/issues/$num" "" || die "Read-back HTTP $GH_HTTP: $(git_err)"
  note "GET issue: HTTP $GH_HTTP"
  state="$(printf '%s' "$GH_BODY" | jq -r '.state // empty')"
  [ -n "$state" ] || die "git issue: Read-back ohne state"
  printf 'OK\t%s\t%s\t%s\t%s\n' "$GIT_OWNER/$GIT_REPO" "$num" "$state" "$url"
}

git_issue_close() {
  [ $# -ge 2 ] || die "git issue-close: <repo> <nummer> fehlt"
  local repo="$1" num="$2" payload state url
  git_owner_repo "git issue-close" "$repo"
  [[ "$num" =~ ^[0-9]+$ ]] || die "git issue-close: ungueltige Nummer '$num'"
  payload='{"state":"closed"}'
  gh_api PATCH "/repos/$GIT_OWNER/$GIT_REPO/issues/$num" "$payload" || die "HTTP $GH_HTTP: $(git_err)"
  note "PATCH issue: HTTP $GH_HTTP"
  gh_api GET "/repos/$GIT_OWNER/$GIT_REPO/issues/$num" "" || die "Read-back HTTP $GH_HTTP: $(git_err)"
  note "GET issue: HTTP $GH_HTTP"
  state="$(printf '%s' "$GH_BODY" | jq -r '.state // empty')"
  url="$(printf '%s' "$GH_BODY" | jq -r '.html_url // empty')"
  [ "$state" = "closed" ] || die "git issue-close: Verifikation fehlgeschlagen (state='$state')"
  printf 'OK\t%s\t%s\t%s\t%s\n' "$GIT_OWNER/$GIT_REPO" "$num" "$state" "$url"
}

# git_issue_comment <repo|owner/repo> <nummer> (--body <B> | --file <md>)
# Postet einen Kommentar auf ein Issue (POST
# /repos/{owner}/{repo}/issues/{nr}/comments) und verifiziert ihn per Read-back:
# der angelegte Kommentar wird ueber seine ID erneut gelesen
# (GET /repos/{owner}/{repo}/issues/comments/{id}) und der Inhalt verglichen.
# Ausgabe (TAB-getrennt): OK<TAB>owner/repo<TAB>nummer<TAB>kommentar-id<TAB>url
git_issue_comment() {
  [ $# -ge 2 ] || die "git issue-comment: <repo> <nummer> fehlt"
  local repo="$1" num="$2"; shift 2
  local body="" file="" payload id url cbody
  while [ $# -gt 0 ]; do case "$1" in
    --body) [ $# -ge 2 ] || die "git issue-comment: --body braucht einen Wert"; body="$2"; shift 2 ;;
    --file) [ $# -ge 2 ] || die "git issue-comment: --file braucht einen Wert"; file="$2"; shift 2 ;;
    *) die "git issue-comment: unbekannte Option '$1'" ;;
  esac; done
  git_owner_repo "git issue-comment" "$repo"
  [[ "$num" =~ ^[0-9]+$ ]] || die "git issue-comment: ungueltige Nummer '$num'"
  if [ -n "$file" ] && [ -n "$body" ]; then die "git issue-comment: --body und --file nicht gleichzeitig"; fi
  if [ -n "$file" ]; then
    [ -f "$file" ] || die "Datei nicht gefunden: $file"
    body="$(cat "$file")"
  fi
  [ -n "$body" ] || die "git issue-comment: --body oder --file fehlt (Kommentartext)"
  payload="$(jq -nc --arg b "$body" '{body:$b}')"
  gh_api POST "/repos/$GIT_OWNER/$GIT_REPO/issues/$num/comments" "$payload" || die "HTTP $GH_HTTP: $(git_err)"
  note "POST issue-comment: HTTP $GH_HTTP"
  id="$(printf '%s' "$GH_BODY" | jq -r '.id // empty')"
  url="$(printf '%s' "$GH_BODY" | jq -r '.html_url // empty')"
  [ -n "$id" ] || die "git issue-comment: keine Kommentar-ID in der Antwort"
  gh_api GET "/repos/$GIT_OWNER/$GIT_REPO/issues/comments/$id" "" || die "Read-back HTTP $GH_HTTP: $(git_err)"
  note "GET issue-comment: HTTP $GH_HTTP"
  cbody="$(printf '%s' "$GH_BODY" | jq -r '.body // empty')"
  [ "$cbody" = "$body" ] || die "git issue-comment: Verifikation fehlgeschlagen (Inhalt weicht ab)"
  printf 'OK\t%s\t%s\t%s\t%s\n' "$GIT_OWNER/$GIT_REPO" "$num" "$id" "$url"
}

# Gemeinsame Verarbeitung der Filter-Optionen --state/--label fuer
# listen-artige Git-Befehle (issues/pulls). Setzt die Variablen
# GIT_LIST_STATE (open|closed|all), GIT_LIST_LABEL und GIT_LIST_LABEL_ENC
# (URL-kodierte Form des Labels, leer = keiner).
git_list_opts() {
  local who="$1"; shift
  GIT_LIST_STATE="open"; GIT_LIST_LABEL=""; GIT_LIST_LABEL_ENC=""
  while [ $# -gt 0 ]; do case "$1" in
    --state) [ $# -ge 2 ] || die "$who: --state braucht einen Wert"; GIT_LIST_STATE="$2"; shift 2 ;;
    --label) [ $# -ge 2 ] || die "$who: --label braucht einen Wert"; GIT_LIST_LABEL="$2"; shift 2 ;;
    *) die "$who: unbekannte Option '$1'" ;;
  esac; done
  case "$GIT_LIST_STATE" in open|closed|all) ;; *) die "$who: ungueltiger --state '$GIT_LIST_STATE' (open|closed|all)" ;; esac
  if [ -n "$GIT_LIST_LABEL" ]; then
    GIT_LIST_LABEL_ENC="$(git_uri_enc "$GIT_LIST_LABEL")" || die "$who: Label nicht kodierbar"
  fi
}

# Haengt den labels-Filter (URL-kodiert) an einen Query-Pfad an (falls gesetzt).
git_list_path() {
  local path="$1"
  if [ -n "$GIT_LIST_LABEL_ENC" ]; then
    path="$path&labels=$GIT_LIST_LABEL_ENC"
  fi
  printf '%s' "$path"
}

git_issues() {
  [ $# -ge 1 ] || die "git issues: <repo> fehlt"
  local repo="$1"; shift
  local path
  git_list_opts "git issues" "$@"
  git_require_repo "git issues" "$repo"
  path="$(git_list_path "/repos/$GITHUB_OWNER/$repo/issues?state=$GIT_LIST_STATE&per_page=100")"
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git issues"
  printf '%s' "$GH_BODY" | jq -r '.[] | [.number, .state, .title, ((.labels // []) | map(.name) | join(",")), .html_url] | @tsv'
}

git_issues_all() {
  local path
  git_list_opts "git issues-all" "$@"
  path="$(git_list_path "/user/issues?state=$GIT_LIST_STATE&filter=all&per_page=100")"
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git issues-all"
  printf '%s' "$GH_BODY" | jq -r '
      .[]
      | select(.pull_request == null)
      | [
          (.repository.full_name // "?"),
          .number,
          .state,
          .title,
          ((.labels // []) | map(.name) | join(",")),
          .html_url
        ]
      | @tsv'
}

# git_pulls <repo> [--state open|closed|all] [--label <l>]
# Listet Pull Requests eines Repos (read-only) TAB-getrennt:
#   nummer<TAB>state<TAB>titel<TAB>labels<TAB>autor<TAB>html_url
git_pulls() {
  [ $# -ge 1 ] || die "git pulls: <repo> fehlt"
  local repo="$1"; shift
  local path
  git_list_opts "git pulls" "$@"
  git_require_repo "git pulls" "$repo"
  path="$(git_list_path "/repos/$GITHUB_OWNER/$repo/pulls?state=$GIT_LIST_STATE&per_page=100")"
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git pulls"
  printf '%s' "$GH_BODY" | jq -r '.[] | [.number, .state, .title, ((.labels // []) | map(.name) | join(",")), (.user.login // ""), .html_url] | @tsv'
}

# git_pulls_all [--state open|closed|all] [--label <l>]
# Listet Pull Requests ueber alle sichtbaren Repos (read-only) TAB-getrennt:
#   repo<TAB>nummer<TAB>state<TAB>titel<TAB>labels<TAB>autor<TAB>html_url
git_pulls_all() {
  local path
  git_list_opts "git pulls-all" "$@"
  path="$(git_list_path "/user/issues?state=$GIT_LIST_STATE&filter=all&per_page=100")"
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git pulls-all"
  printf '%s' "$GH_BODY" | jq -r '
      .[]
      | select(.pull_request != null)
      | [
          (.repository.full_name // "?"),
          .number,
          .state,
          .title,
          ((.labels // []) | map(.name) | join(",")),
          (.user.login // ""),
          .html_url
        ]
      | @tsv'
}

git_cmd() {
  # Fail-fast: schlaegt git_token fehl (z. B. Token-Befehl nicht ausfuehrbar),
  # darf die Zuweisung den Fehler nicht verschlucken und mit leerem Token
  # weiterlaufen. git_token meldet den Fehler bereits genau einmal auf stderr;
  # hier nur der harte Abbruch (kein zusaetzlicher Text, keine Doppelmeldung).
  TOK="$(git_token)" || exit 1
  local sub; sub="${1:-}"; shift || true
  case "$sub" in
    info) git_info "$@" ;;
    branches) git_branches "$@" ;;
    commits) git_commits "$@" ;;
    repos) git_repos "$@" ;;
    list) git_list "$@" ;;
    create-repo) git_create_repo "$@" ;;
    upload) git_upload "$@" ;;
    read) git_read "$@" ;;
    cat) git_read "$@" ;;
    clone) git_clone "$@" ;;
    pull) git_pull "$@" ;;
    status) git_status "$@" ;;
    issue) git_issue "$@" ;;
    issue-close) git_issue_close "$@" ;;
    issue-comment) git_issue_comment "$@" ;;
    issues) git_issues "$@" ;;
    issues-all) git_issues_all "$@" ;;
    pulls) git_pulls "$@" ;;
    pulls-all) git_pulls_all "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "git: unbekannter Unterbefehl (info|branches|commits|repos|list|create-repo|upload|read|cat|clone|pull|status|issue|issue-close|issue-comment|issues|issues-all|pulls|pulls-all)" ;;
  esac
}

# ---------------- Doctor (Selbstdiagnose, read-only) ----------------
# doctor_cmd prueft Konfiguration und Erreichbarkeit, OHNE Werte auszugeben.
# Ausgabe: je Pruefung eine Zeile "<pruefung>\t<OK|WARN|FAIL>\t<detail>".
# Das Detail nennt nur Schluesselnamen/Status/HTTP-Codes - nie Werte (keine URL,
# kein Host, kein Token, kein Pfad-Inhalt, keine E-Mail).
# Exit: 0 wenn keine Pruefung FAIL, 1 wenn mindestens eine FAIL (WARN allein -> 0).
#
# doctor laeuft im Dispatch VOR require_config/wiki_ca_opts, damit auch eine
# unvollstaendige oder fehlerhafte Konfiguration gemeldet statt abgebrochen wird.
# Innerhalb der Pruefungen wird deshalb kein die() verwendet: Helfer, die bei
# Fehlern abbrechen (wiki_login/wiki_http/wiki_ca_opts/git_token), laufen in
# einer Subshell - ein Abbruch beendet nur diese Subshell, nicht doctor.

DOCTOR_FAILS=0

# doctor_line <pruefung> <OK|WARN|FAIL> <detail>
doctor_line() {
  printf '%s\t%s\t%s\n' "$1" "$2" "$3"
  if [ "$2" = "FAIL" ]; then DOCTOR_FAILS=$((DOCTOR_FAILS + 1)); fi
  return 0
}

# 1) benoetigte Werkzeuge (openssl nur fuer die CA-Pruefung)
doctor_deps() {
  local miss=() tool
  for tool in jq curl; do
    command -v "$tool" >/dev/null 2>&1 || miss+=("$tool")
  done
  if [ -n "$TEAMCTL_WIKI_CA" ] && ! command -v openssl >/dev/null 2>&1; then
    miss+=("openssl")
  fi
  if [ "${#miss[@]}" -gt 0 ]; then
    doctor_line deps FAIL "fehlt: ${miss[*]}"
  else
    doctor_line deps OK "jq/curl vorhanden"
  fi
}

# 2) Pflichtwerte gesetzt + https://-Zwang (Details nur Schluesselnamen)
doctor_config() {
  local miss=() bad=() det=""
  [ -n "$INFRA_HOST" ]   || miss+=("TEAMCTL_INFRA_HOST")
  [ -n "$WIKI_BASE" ]    || miss+=("TEAMCTL_WIKI_URL")
  [ -n "$WIKI_EMAIL" ]   || miss+=("TEAMCTL_WIKI_EMAIL")
  [ -n "$BLOG_DIR" ]     || miss+=("TEAMCTL_BLOG_ROOT")
  [ -n "$GITHUB_OWNER" ] || miss+=("TEAMCTL_GIT_OWNER")
  [ -n "$GITHUB_API" ]   || miss+=("TEAMCTL_GIT_API")
  case "$GITHUB_API" in ""|https://*) ;; *) bad+=("TEAMCTL_GIT_API") ;; esac
  case "$WIKI_BASE"  in ""|https://*) ;; *) bad+=("TEAMCTL_WIKI_URL") ;; esac
  if [ "${#miss[@]}" -gt 0 ]; then det="fehlt: ${miss[*]}"; fi
  if [ "${#bad[@]}" -gt 0 ]; then
    if [ -n "$det" ]; then det="$det; "; fi
    det="${det}kein https://: ${bad[*]}"
  fi
  if [ -n "$det" ]; then
    doctor_line config FAIL "$det"
  else
    doctor_line config OK "Pflichtwerte gesetzt, https:// ok"
  fi
}

# 3) Wiki-CA - nur wenn TEAMCTL_WIKI_CA gesetzt ist
doctor_wiki_ca() {
  [ -n "$TEAMCTL_WIKI_CA" ] || return 0
  local detail rc
  # wiki_ca_opts bricht bei Fehlern per die ab -> in Subshell ausfuehren und den
  # Klartextgrund uebernehmen (nennt nur TEAMCTL_WIKI_CA, nie den Pfad/Inhalt).
  detail="$( ( wiki_ca_opts ) 2>&1 )"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    # gueltig: CA-Option ueber den vorhandenen Helfer im Hauptprozess setzen,
    # damit der Wiki-Aufruf (Pruefung 4) dieselbe TLS-Verifikation nutzt.
    wiki_ca_opts
    doctor_line wiki-ca OK "PEM lesbar"
  else
    # "teamctl: FEHLER: "-Praefix der die-Meldung entfernen - der Grund selbst
    # nennt nur TEAMCTL_WIKI_CA (nie den Pfad/Inhalt).
    detail="${detail#teamctl: FEHLER: }"
    [ -n "$detail" ] || detail="TEAMCTL_WIKI_CA: ungueltig"
    doctor_line wiki-ca FAIL "$detail"
  fi
}

# 4) Wiki: Login + POST /api/spaces/ ueber die vorhandene Login-/API-Logik.
# Laeuft in einer Subshell; ein die() beendet nur die Subshell.
doctor_wiki_probe() {
  if ! wiki_login "$WIKI_AS" >/dev/null 2>&1; then
    printf 'LOGIN'
    return 0
  fi
  wiki_api "spaces/" '{}' >/dev/null 2>&1
  if [ -n "$WIKI_HTTP" ]; then printf 'HTTP %s' "$WIKI_HTTP"; else printf 'HTTP -'; fi
}

doctor_wiki_api() {
  local res
  res="$(doctor_wiki_probe 2>/dev/null)"
  case "$res" in
    "HTTP 200") doctor_line wiki-api OK "HTTP 200" ;;
    "HTTP "*)   doctor_line wiki-api FAIL "$res" ;;
    "LOGIN")    doctor_line wiki-api FAIL "Login fehlgeschlagen (kein HTTP-Code)" ;;
    *)          doctor_line wiki-api FAIL "keine HTTP-Antwort (Login/Verbindung)" ;;
  esac
}

# 5) GitHub-Token lesbar und nicht leer (Token wird NIE ausgegeben).
# Der Token wird - wie in git_cmd - in die globale Variable TOK gelegt, damit
# die folgende gh_api-Pruefung ihn als Bearer-Header nutzt.
doctor_git_token() {
  local rc
  TOK="$(git_token 2>/dev/null)"
  rc=$?
  if [ "$rc" -eq 0 ] && [ -n "$TOK" ]; then
    doctor_line git-token OK "Token lesbar"
  else
    TOK=""
    doctor_line git-token FAIL "Token nicht lesbar/leer (TEAMCTL_GITHUB_TOKEN_CMD)"
  fi
}

# 6) GitHub-API: GET /user ueber gh_api
doctor_git_api() {
  local rc code
  if [ -z "$TOK" ]; then
    doctor_line git-api FAIL "kein Token (siehe git-token)"
    return 0
  fi
  gh_api GET /user "" >/dev/null 2>&1
  rc=$?
  code="$GH_HTTP"
  [ -n "$code" ] || code="-"
  if [ "$rc" -eq 0 ] && [ "$code" = "200" ]; then
    doctor_line git-api OK "HTTP 200"
  else
    doctor_line git-api FAIL "HTTP $code"
  fi
}

# 7) SSH-Key: nur Warnung (kein Abbruch)
doctor_ssh_key() {
  if [ -f "$SSH_KEY" ]; then
    doctor_line ssh-key OK "vorhanden"
  else
    doctor_line ssh-key WARN "Datei fehlt (TEAMCTL_SSH_KEY)"
  fi
}

doctor_cmd() {
  DOCTOR_FAILS=0
  doctor_deps
  doctor_config
  doctor_wiki_ca
  doctor_wiki_api
  doctor_git_token
  doctor_git_api
  doctor_ssh_key
  if [ "$DOCTOR_FAILS" -gt 0 ]; then return 1; fi
  return 0
}

# ---------------- Dispatch ----------------
cmd="${1:-}"; shift || true
case "$cmd" in
  ""|-h|--help|help) usage; exit 0 ;;
  doctor) doctor_cmd "$@"; exit $? ;;
esac
require_config
# CA-Zustand EINMAL im Hauptprozess initialisieren (fail-fast, keine Subshell).
wiki_ca_opts
case "$cmd" in
  wiki) wiki_cmd "$@" ;;
  blog) blog_cmd "$@" ;;
  git)  git_cmd "$@" ;;
  *) die "unbekannter Befehl '$cmd' (wiki|blog|git|doctor|help)" ;;
esac
