#!/usr/bin/env bash
# teamctl - Gemeinsames internes CLI fuer Wiki (Docmost), Blog und Git.
# Kurze Befehle fuer alle Agents. Gibt keine Secrets aus.
# Doku: siehe README.md im selben Verzeichnis.
set -uo pipefail

# Eigenen Pfad robust aufloesen - funktioniert auch, wenn teamctl als
# Symlink/Wrapper aus einem PATH-Verzeichnis aufgerufen wird.
_SELF_SRC="${BASH_SOURCE[0]:-$0}"
while [ -L "$_SELF_SRC" ]; do
  _SELF_LINK_DIR="$(cd -P "$(dirname "$_SELF_SRC")" && pwd)"
  _SELF_SRC="$(readlink "$_SELF_SRC")"
  case "$_SELF_SRC" in
    /*) ;;
    *) _SELF_SRC="$_SELF_LINK_DIR/$_SELF_SRC" ;;
  esac
done
SELF_DIR="$(cd -P "$(dirname "$_SELF_SRC")" && pwd)"
unset _SELF_SRC _SELF_LINK_DIR

# ---------------- Konfiguration ----------------
# Infrastruktur-Werte (Host, URL, Owner, API) stehen NICHT im Skript, sondern in
# einer vertraulichen Datei (chmod 600, nicht in Git).
# Reihenfolge: echte Umgebungsvariable > Konfigurationsdatei > generische Vorgaben.

CONFIG_FILE="${TEAMCTL_ENV_FILE:-$SELF_DIR/teamctl.env}"

# Schluessel, deren Umgebungswert Vorrang vor der Datei behaelt.
CONFIG_KEYS=(
  TEAMCTL_INFRA_HOST TEAMCTL_WIKI_URL TEAMCTL_WIKI_EMAIL TEAMCTL_BLOG_ROOT
  TEAMCTL_GIT_OWNER TEAMCTL_GIT_API TEAMCTL_GITHUB_TOKEN_CMD
  TEAMCTL_SSH_KEY TEAMCTL_WIKI_CREDS TEAMCTL_WIKI_AS TEAMCTL_WIKI_CA
)

declare -A _ENV_SAVE=()
for _k in "${CONFIG_KEYS[@]}"; do _ENV_SAVE["$_k"]="${!_k:-}"; done

if [ -f "$CONFIG_FILE" ]; then
  # Sicherheit (N5): die Konfigurationsdatei wird als Shell-Code eingelesen.
  # Deshalb VOR dem Sourcen Besitzer und Schreibrechte pruefen - eine von
  # Dritten manipulierbare oder einem fremden Konto gehoerende Datei darf
  # nicht ausgefuehrt werden. Regel: regulaere Datei (kein Symlink),
  # Eigentuemer = aktueller Nutzer (oder root), nicht gruppen-/welt-schreibbar.
  _cf_err=""
  if [ -L "$CONFIG_FILE" ]; then
    _cf_err="Symlink"
  else
    _cf_owner="$(stat -c '%u' "$CONFIG_FILE" 2>/dev/null || printf '')"
    case "$_cf_owner" in
      "$(id -u)"|0) ;;
      *) _cf_err="fremder Eigentuemer" ;;
    esac
    if [ -z "$_cf_err" ] && [ -n "$(find "$CONFIG_FILE" -maxdepth 0 -perm /022 -print 2>/dev/null)" ]; then
      _cf_err="gruppe-/welt-schreibbar"
    fi
  fi
  if [ -n "$_cf_err" ]; then
    printf 'teamctl: FEHLER: Konfigurationsdatei unsicher (%s) - wird nicht geladen.\n' "$_cf_err" >&2
    printf 'teamctl: Datei: %s\n' "$CONFIG_FILE" >&2
    printf 'teamctl: Erwartet: regulaere Datei, Eigentuemer = aktueller Nutzer, Modus ohne Gruppen-/Welt-Schreibrecht (chmod 600).\n' >&2
    exit 1
  fi
  unset _cf_err _cf_owner
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

# Echte Umgebungsvariablen haben Vorrang vor der Datei.
for _k in "${CONFIG_KEYS[@]}"; do
  if [ -n "${_ENV_SAVE[$_k]}" ]; then export "$_k=${_ENV_SAVE[$_k]}"; fi
done
unset _ENV_SAVE _k

# Fehler-/Hinweisausgabe. Bewusst frueh definiert, damit auch die
# Konfigurationspruefung (CA-Zustand) direkt abbrechen kann.
# Pflichtwerte - bewusst OHNE Default im Skript (Infra ist austauschbar).
INFRA_HOST="${TEAMCTL_INFRA_HOST:-}"
WIKI_BASE="${TEAMCTL_WIKI_URL:-}"
WIKI_EMAIL="${TEAMCTL_WIKI_EMAIL:-}"
BLOG_DIR="${TEAMCTL_BLOG_ROOT:-}"
GITHUB_OWNER="${TEAMCTL_GIT_OWNER:-}"
GITHUB_API="${TEAMCTL_GIT_API:-}"

# Generische Vorgaben (Pfade/Befehle - keine Infra-Adressen).
SSH_KEY="${TEAMCTL_SSH_KEY:-$HOME/.ssh/id_ed25519}"
WIKI_CREDS="${TEAMCTL_WIKI_CREDS:-$SELF_DIR/wiki-credentials.txt}"
GITHUB_TOKEN_CMD="${TEAMCTL_GITHUB_TOKEN_CMD:-gh auth token}"
WIKI_AS="${TEAMCTL_WIKI_AS:-$WIKI_EMAIL}"

config_error() {
  printf 'teamctl: FEHLER: %s\n' "$*" >&2
  printf 'teamctl: Konfigurationsdatei: %s\n' "$CONFIG_FILE" >&2
  printf 'teamctl: Pflichtwerte dort setzen (Vorlage: .env.example).\n' >&2
  exit 1
}

# require_https <schluesselname> <wert> <bezeichnung>
# Erzwingt das Schema "https://" (exakt klein geschrieben, kein
# Gross-/Kleinschreibungs-Trick) und bricht ueber config_error ab - die Meldung
# nennt nur den Schluesselnamen, nie den Wert. <bezeichnung> ist das Substantiv
# der Meldung (z. B. "die API"/"die URL"), damit die Meldungstexte identisch zu
# den frueheren, getrennten case-Bloecken bleiben.
require_https() {
  local key="$1" val="$2" what="$3"
  case "$val" in
    https://*) return 0 ;;
    *) config_error "$key: ungueltig - $what muss mit https:// beginnen" ;;
  esac
}

require_config() {
  local missing=()
  [ -n "$INFRA_HOST" ]   || missing+=("TEAMCTL_INFRA_HOST")
  [ -n "$WIKI_BASE" ]    || missing+=("TEAMCTL_WIKI_URL")
  [ -n "$WIKI_EMAIL" ]   || missing+=("TEAMCTL_WIKI_EMAIL")
  [ -n "$BLOG_DIR" ]     || missing+=("TEAMCTL_BLOG_ROOT")
  [ -n "$GITHUB_OWNER" ] || missing+=("TEAMCTL_GIT_OWNER")
  [ -n "$GITHUB_API" ]   || missing+=("TEAMCTL_GIT_API")
  if [ "${#missing[@]}" -gt 0 ]; then
    config_error "Konfiguration unvollstaendig - fehlt: ${missing[*]}"
  fi
  # Sicherheit: der Bearer-Token darf nie ueber Klartext-HTTP gehen - deshalb
  # ist ausschliesslich "https://" erlaubt (exakt klein geschrieben, kein
  # Gross-/Kleinschreibungs-Trick). Dasselbe gilt fuer die Wiki-URL, die
  # Zugangsdaten (Session-Cookie/Basic-Auth) traegt. Beide Meldungen nennen nur
  # den jeweiligen Schluesselnamen - nie den Wert/die URL.
  require_https TEAMCTL_GIT_API  "$GITHUB_API" "die API"
  require_https TEAMCTL_WIKI_URL "$WIKI_BASE"  "die URL"
}

# curl-Basisoptionen. '-k' (TLS-Verifikation aus) steht bewusst NICHT hier:
# global gesetzt wuerde es jedes spaetere '--cacert' entwerten (H2). Die
# TLS-Entscheidung faellt ausschliesslich in wiki_ca_opts (WIKI_CURL_OPTS).
CURL_OPTS=(-s --max-time 60)
SSH_OPTS=(-o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=15)

TOK=""
WIKI_COOKIE=""
WIKI_HTTP=""
WIKI_BODY=""
GH_HTTP=""
GH_BODY=""
TMPFILES=()

die()  { printf 'teamctl: FEHLER: %s\n' "$*" >&2; exit 1; }
note() { printf 'teamctl: %s\n' "$*" >&2; }
# TLS-Verifikation fuer das Wiki (Leaf == CA, selbstsigniert).
# Der Pfad zur CA-Datei kommt aus der Konfiguration; der Dateiinhalt
# (Zertifikat) liegt ausserhalb von Git. Der Zustand wird EINMAL im
# Hauptprozess geprueft (fail-fast), damit alle Wiki-Aufrufe mit derselben
# CA laufen. Meldungen nennen nur den Schluesselnamen - nie den Wert/Pfad.
TEAMCTL_WIKI_CA="${TEAMCTL_WIKI_CA:-}"

# curl-Argumente fuer Wiki-Aufrufe (leer = System-CA, sonst explizite CA).
WIKI_CURL_OPTS=()

# wiki_ca_opts - CA-Zustand pruefen und WIKI_CURL_OPTS setzen.
# Setzt der Hauptprozess, nicht eine Subshell: sonst ginge die CA-Option
# verloren und ein Abbruch beendete nur die Subshell (fail-soft).
# Fehlermeldungen nennen ausschliesslich TEAMCTL_WIKI_CA - nie den Wert/Pfad.
wiki_ca_opts() {
  # Ohne TEAMCTL_WIKI_CA bleibt die TLS-Verifikation aus (-k) - nur fuer die
  # selbstsignierte Infrastruktur noetig und NUR hier gesetzt, nie global in
  # CURL_OPTS (sonst wuerde ein gesetztes --cacert entwertet, H2).
  WIKI_CURL_OPTS=(-k)
  if [ -z "$TEAMCTL_WIKI_CA" ]; then
    return 0
  fi
  if [ ! -e "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: Datei fehlt."
  fi
  if [ -d "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: Pfad ist ein Verzeichnis."
  fi
  if [ ! -f "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: kein regulaerer Dateityp."
  fi
  if [ ! -r "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: Datei nicht lesbar."
  fi
  if [ ! -s "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: Datei ist leer."
  fi
  if ! head -c 12 -- "$TEAMCTL_WIKI_CA" 2>/dev/null | grep -q -- "-----BEGIN"; then
    die "TEAMCTL_WIKI_CA: Datei ist kein PEM-Zertifikat."
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    die "TEAMCTL_WIKI_CA: Werkzeug openssl fehlt zur CA-Pruefung."
  fi
  if ! openssl x509 -in "$TEAMCTL_WIKI_CA" -noout >/dev/null 2>&1; then
    die "TEAMCTL_WIKI_CA: openssl konnte die Datei nicht als Zertifikat lesen."
  fi
  # CA gesetzt: echte Verifikation ueber --cacert; kein -k hier.
  WIKI_CURL_OPTS=(--cacert "$TEAMCTL_WIKI_CA")
}

cleanup() {
  [ -n "$WIKI_COOKIE" ] && rm -f "$WIKI_COOKIE"
  if [ "${#TMPFILES[@]}" -gt 0 ]; then rm -f "${TMPFILES[@]}"; fi
  return 0
}
trap cleanup EXIT

mktmp() { local f; f="$(mktemp)"; TMPFILES+=("$f"); printf '%s' "$f"; }

# ---------------- Retry / Backoff (HTTP 429) ----------------
# Wiederholte Login-/API-Aufrufe am Wiki loesen sporadisch HTTP 429 aus.
# Wiki-HTTP-Aufrufe werden daher begrenzt wiederholt: exponentielles Backoff
# mit Zufallsanteil (Jitter), damit sich parallele Agents nicht synchronisieren.
# Steuerbar per Umgebungsvariable oder teamctl.env:
#   TEAMCTL_RETRY_MAX   Wiederholungen nach dem ersten Versuch (Default 4)
#   TEAMCTL_RETRY_BASE  Basis-Sekunden fuer 2^Versuch (Default 2)
#   TEAMCTL_RETRY_CAP   Obergrenze der Wartezeit je Versuch in s (Default 30)
TEAMCTL_RETRY_MAX="${TEAMCTL_RETRY_MAX:-4}"
TEAMCTL_RETRY_BASE="${TEAMCTL_RETRY_BASE:-2}"
TEAMCTL_RETRY_CAP="${TEAMCTL_RETRY_CAP:-30}"

# retry_delay <versuch> -> Wartezeit in Sekunden (exponentiell + Jitter, >=1)
retry_delay() {
  local attempt="$1" d
  d=$(( TEAMCTL_RETRY_BASE ** attempt ))
  if [ "$d" -gt "$TEAMCTL_RETRY_CAP" ]; then d="$TEAMCTL_RETRY_CAP"; fi
  if [ "$d" -lt 1 ]; then d=1; fi
  printf '%s' "$(( 1 + RANDOM % d ))"
}

# retry_after_secs <headerdatei> -> begrenzte Wartezeit in Sekunden oder leer
# Wertet JEDEN retry-after*-Header aus (case-insensitive): den Standard
# "Retry-After" ebenso wie den vom Wiki bei HTTP 429 gelieferten
# "retry-after-auth". Bei mehreren Angaben gilt der groesste Wert; das Ergebnis
# wird auf TEAMCTL_RETRY_CAP begrenzt, damit ein unbrauchbarer Headerwert
# (z. B. ein HTTP-Datum) die Wartezeit nicht sprengt.
retry_after_secs() {
  local hdr="$1"
  # Die Begrenzung auf TEAMCTL_RETRY_CAP passiert IN awk: Headerwerte oberhalb
  # der bash-Ganzzahlgrenze (z. B. 99999999999999999999) liefern eine
  # Fliesskommaform, bei der der bash-Vergleich "[ $secs -gt $cap ]" still
  # scheitert und nicht kappt. awk vergleicht exakt und gibt per "%d" einen
  # reinen Integer aus (kein 1e+20).
  awk -v cap="$TEAMCTL_RETRY_CAP" '
    BEGIN { m = 0 }
    { h = tolower($1) }
    h ~ /^retry-after/ {
      v = $2; gsub(/[^0-9]/, "", v)
      if (v != "" && v + 0 > m) m = v + 0
    }
    END {
      if (m > cap) m = cap
      if (m > 0) printf "%d\n", m
    }
  ' "$hdr" 2>/dev/null
}

# wiki_http <ausgabedatei> <curl-argumente...>
# Fuehrt einen Wiki-HTTP-Aufruf aus und wiederholt ihn bei HTTP 429.
# Gibt den HTTP-Code auf stdout aus; der Body landet in <ausgabedatei>.
# Ein vorhandener retry-after*-Header (Standard "Retry-After" oder der vom Wiki
# bei HTTP 429 gelieferte "retry-after-auth") wird respektiert.
wiki_http() {
  local out="$1"; shift
  local hdr attempt=0 code delay ra
  hdr="$(mktmp)"
  while :; do
    code="$(curl "${CURL_OPTS[@]}" "${WIKI_CURL_OPTS[@]}" -D "$hdr" -o "$out" -w '%{http_code}' "$@")"
    # HTTP 000: kein HTTP-Status = TLS-/Verbindungsfehler. Klar abbrechen,
    # statt den Fehler als regulaeren Code weiterzureichen. Die Meldung
    # nennt bewusst keine Werte/URLs.
    if [ "$code" = "000" ]; then
      die "Wiki: keine HTTP-Antwort (TLS-/Verbindungsfehler) - Aufruf abgebrochen."
    fi
    if [ "$code" != "429" ]; then printf '%s' "$code"; return 0; fi
    if [ "$attempt" -ge "$TEAMCTL_RETRY_MAX" ]; then
      note "Wiki: HTTP 429 (Too Many Requests) - $TEAMCTL_RETRY_MAX Wiederholungen erschoepft, gebe auf"
      printf '%s' "$code"; return 0
    fi
    attempt=$(( attempt + 1 ))
    delay="$(retry_delay "$attempt")"
    ra="$(retry_after_secs "$hdr")"
    if [ -n "$ra" ] && [ "$ra" -gt "$delay" ] 2>/dev/null; then delay="$ra"; fi
    note "Wiki: HTTP 429 (Too Many Requests) - Wiederholung $attempt/$TEAMCTL_RETRY_MAX in ${delay}s"
    sleep "$delay"
  done
}

