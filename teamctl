#!/usr/bin/env bash
# teamctl - Gemeinsames internes CLI fuer Wiki (Docmost), Blog und Git.
# Kurze Befehle fuer alle Agents. Gibt keine Secrets aus.
# Doku: siehe README.md im selben Verzeichnis.
set -uo pipefail

# Eigenen Pfad robust aufloesen - funktioniert auch, wenn teamctl als
# Symlink/Wrapper aus einem PATH-Verzeichnis aufgerufen wird.
_SELF_SRC="${BASH_SOURCE[0]:-$0}"
while [ -L "$_SELF_SRC" ]; do
  _SELF_LINK_DIR="$(cd -P "$(dirname "$_SELF_SRC")" && pwd)"
  _SELF_SRC="$(readlink "$_SELF_SRC")"
  case "$_SELF_SRC" in
    /*) ;;
    *) _SELF_SRC="$_SELF_LINK_DIR/$_SELF_SRC" ;;
  esac
done
SELF_DIR="$(cd -P "$(dirname "$_SELF_SRC")" && pwd)"
unset _SELF_SRC _SELF_LINK_DIR

# ---------------- Konfiguration ----------------
# Infrastruktur-Werte (Host, URL, Owner, API) stehen NICHT im Skript, sondern in
# einer vertraulichen Datei (chmod 600, nicht in Git).
# Reihenfolge: echte Umgebungsvariable > Konfigurationsdatei > generische Vorgaben.

CONFIG_FILE="${TEAMCTL_ENV_FILE:-$SELF_DIR/teamctl.env}"

# Schluessel, deren Umgebungswert Vorrang vor der Datei behaelt.
CONFIG_KEYS=(
  TEAMCTL_INFRA_HOST TEAMCTL_WIKI_URL TEAMCTL_WIKI_EMAIL TEAMCTL_BLOG_ROOT
  TEAMCTL_GIT_OWNER TEAMCTL_GIT_API TEAMCTL_GITHUB_TOKEN_CMD
  TEAMCTL_SSH_KEY TEAMCTL_WIKI_CREDS TEAMCTL_WIKI_AS TEAMCTL_WIKI_CA
)

declare -A _ENV_SAVE=()
for _k in "${CONFIG_KEYS[@]}"; do _ENV_SAVE["$_k"]="${!_k:-}"; done

if [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

# Echte Umgebungsvariablen haben Vorrang vor der Datei.
for _k in "${CONFIG_KEYS[@]}"; do
  if [ -n "${_ENV_SAVE[$_k]}" ]; then export "$_k=${_ENV_SAVE[$_k]}"; fi
done
unset _ENV_SAVE _k

# Fehler-/Hinweisausgabe. Bewusst frueh definiert, damit auch die
# Konfigurationspruefung (CA-Zustand) direkt abbrechen kann.
# Pflichtwerte - bewusst OHNE Default im Skript (Infra ist austauschbar).
INFRA_HOST="${TEAMCTL_INFRA_HOST:-}"
WIKI_BASE="${TEAMCTL_WIKI_URL:-}"
WIKI_EMAIL="${TEAMCTL_WIKI_EMAIL:-}"
BLOG_DIR="${TEAMCTL_BLOG_ROOT:-}"
GITHUB_OWNER="${TEAMCTL_GIT_OWNER:-}"
GITHUB_API="${TEAMCTL_GIT_API:-}"

# Generische Vorgaben (Pfade/Befehle - keine Infra-Adressen).
SSH_KEY="${TEAMCTL_SSH_KEY:-$HOME/.ssh/id_ed25519}"
WIKI_CREDS="${TEAMCTL_WIKI_CREDS:-$SELF_DIR/wiki-credentials.txt}"
GITHUB_TOKEN_CMD="${TEAMCTL_GITHUB_TOKEN_CMD:-gh auth token}"
WIKI_AS="${TEAMCTL_WIKI_AS:-$WIKI_EMAIL}"

config_error() {
  printf 'teamctl: FEHLER: %s\n' "$*" >&2
  printf 'teamctl: Konfigurationsdatei: %s\n' "$CONFIG_FILE" >&2
  printf 'teamctl: Pflichtwerte dort setzen (Vorlage: .env.example).\n' >&2
  exit 1
}

require_config() {
  local missing=()
  [ -n "$INFRA_HOST" ]   || missing+=("TEAMCTL_INFRA_HOST")
  [ -n "$WIKI_BASE" ]    || missing+=("TEAMCTL_WIKI_URL")
  [ -n "$WIKI_EMAIL" ]   || missing+=("TEAMCTL_WIKI_EMAIL")
  [ -n "$BLOG_DIR" ]     || missing+=("TEAMCTL_BLOG_ROOT")
  [ -n "$GITHUB_OWNER" ] || missing+=("TEAMCTL_GIT_OWNER")
  [ -n "$GITHUB_API" ]   || missing+=("TEAMCTL_GIT_API")
  if [ "${#missing[@]}" -gt 0 ]; then
    config_error "Konfiguration unvollstaendig - fehlt: ${missing[*]}"
  fi
  # Sicherheit: der Bearer-Token darf nie ueber Klartext-HTTP gehen - deshalb
  # ist ausschliesslich "https://" erlaubt (exakt klein geschrieben, kein
  # Gross-/Kleinschreibungs-Trick). Die Meldung nennt nur den Schluesselnamen
  # TEAMCTL_GIT_API - nie den Wert/die URL.
  case "$GITHUB_API" in
    https://*) ;;
    *) config_error "TEAMCTL_GIT_API: ungueltig - die API muss mit https:// beginnen" ;;
  esac
}

CURL_OPTS=(-sk --max-time 60)
SSH_OPTS=(-o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=15)

TOK=""
WIKI_COOKIE=""
WIKI_HTTP=""
WIKI_BODY=""
GH_HTTP=""
GH_BODY=""
TMPFILES=()

die()  { printf 'teamctl: FEHLER: %s\n' "$*" >&2; exit 1; }
note() { printf 'teamctl: %s\n' "$*" >&2; }
# TLS-Verifikation fuer das Wiki (Leaf == CA, selbstsigniert).
# Der Pfad zur CA-Datei kommt aus der Konfiguration; der Dateiinhalt
# (Zertifikat) liegt ausserhalb von Git. Der Zustand wird EINMAL im
# Hauptprozess geprueft (fail-fast), damit alle Wiki-Aufrufe mit derselben
# CA laufen. Meldungen nennen nur den Schluesselnamen - nie den Wert/Pfad.
TEAMCTL_WIKI_CA="${TEAMCTL_WIKI_CA:-}"

# curl-Argumente fuer Wiki-Aufrufe (leer = System-CA, sonst explizite CA).
WIKI_CURL_OPTS=()

# wiki_ca_opts - CA-Zustand pruefen und WIKI_CURL_OPTS setzen.
# Setzt der Hauptprozess, nicht eine Subshell: sonst ginge die CA-Option
# verloren und ein Abbruch beendete nur die Subshell (fail-soft).
# Fehlermeldungen nennen ausschliesslich TEAMCTL_WIKI_CA - nie den Wert/Pfad.
wiki_ca_opts() {
  WIKI_CURL_OPTS=()
  if [ -z "$TEAMCTL_WIKI_CA" ]; then
    return 0
  fi
  if [ ! -e "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: Datei fehlt."
  fi
  if [ -d "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: Pfad ist ein Verzeichnis."
  fi
  if [ ! -f "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: kein regulaerer Dateityp."
  fi
  if [ ! -r "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: Datei nicht lesbar."
  fi
  if [ ! -s "$TEAMCTL_WIKI_CA" ]; then
    die "TEAMCTL_WIKI_CA: Datei ist leer."
  fi
  if ! head -c 12 -- "$TEAMCTL_WIKI_CA" 2>/dev/null | grep -q -- "-----BEGIN"; then
    die "TEAMCTL_WIKI_CA: Datei ist kein PEM-Zertifikat."
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    die "TEAMCTL_WIKI_CA: Werkzeug openssl fehlt zur CA-Pruefung."
  fi
  if ! openssl x509 -in "$TEAMCTL_WIKI_CA" -noout >/dev/null 2>&1; then
    die "TEAMCTL_WIKI_CA: openssl konnte die Datei nicht als Zertifikat lesen."
  fi
  WIKI_CURL_OPTS=(--cacert "$TEAMCTL_WIKI_CA")
}

cleanup() {
  [ -n "$WIKI_COOKIE" ] && rm -f "$WIKI_COOKIE"
  if [ "${#TMPFILES[@]}" -gt 0 ]; then rm -f "${TMPFILES[@]}"; fi
  return 0
}
trap cleanup EXIT

mktmp() { local f; f="$(mktemp)"; TMPFILES+=("$f"); printf '%s' "$f"; }

# ---------------- Retry / Backoff (HTTP 429) ----------------
# Wiederholte Login-/API-Aufrufe am Wiki loesen sporadisch HTTP 429 aus.
# Wiki-HTTP-Aufrufe werden daher begrenzt wiederholt: exponentielles Backoff
# mit Zufallsanteil (Jitter), damit sich parallele Agents nicht synchronisieren.
# Steuerbar per Umgebungsvariable oder teamctl.env:
#   TEAMCTL_RETRY_MAX   Wiederholungen nach dem ersten Versuch (Default 4)
#   TEAMCTL_RETRY_BASE  Basis-Sekunden fuer 2^Versuch (Default 2)
#   TEAMCTL_RETRY_CAP   Obergrenze der Wartezeit je Versuch in s (Default 30)
TEAMCTL_RETRY_MAX="${TEAMCTL_RETRY_MAX:-4}"
TEAMCTL_RETRY_BASE="${TEAMCTL_RETRY_BASE:-2}"
TEAMCTL_RETRY_CAP="${TEAMCTL_RETRY_CAP:-30}"

# retry_delay <versuch> -> Wartezeit in Sekunden (exponentiell + Jitter, >=1)
retry_delay() {
  local attempt="$1" d
  d=$(( TEAMCTL_RETRY_BASE ** attempt ))
  if [ "$d" -gt "$TEAMCTL_RETRY_CAP" ]; then d="$TEAMCTL_RETRY_CAP"; fi
  if [ "$d" -lt 1 ]; then d=1; fi
  printf '%s' "$(( 1 + RANDOM % d ))"
}

# wiki_http <ausgabedatei> <curl-argumente...>
# Fuehrt einen Wiki-HTTP-Aufruf aus und wiederholt ihn bei HTTP 429.
# Gibt den HTTP-Code auf stdout aus; der Body landet in <ausgabedatei>.
# Ein vorhandener "Retry-After"-Header wird respektiert.
wiki_http() {
  local out="$1"; shift
  local hdr attempt=0 code delay ra
  hdr="$(mktmp)"
  while :; do
    code="$(curl "${CURL_OPTS[@]}" "${WIKI_CURL_OPTS[@]}" -D "$hdr" -o "$out" -w '%{http_code}' "$@")"
    # HTTP 000: kein HTTP-Status = TLS-/Verbindungsfehler. Klar abbrechen,
    # statt den Fehler als regulaeren Code weiterzureichen. Die Meldung
    # nennt bewusst keine Werte/URLs.
    if [ "$code" = "000" ]; then
      die "Wiki: keine HTTP-Antwort (TLS-/Verbindungsfehler) - Aufruf abgebrochen."
    fi
    if [ "$code" != "429" ]; then printf '%s' "$code"; return 0; fi
    if [ "$attempt" -ge "$TEAMCTL_RETRY_MAX" ]; then
      note "Wiki: HTTP 429 (Too Many Requests) - $TEAMCTL_RETRY_MAX Wiederholungen erschoepft, gebe auf"
      printf '%s' "$code"; return 0
    fi
    attempt=$(( attempt + 1 ))
    delay="$(retry_delay "$attempt")"
    ra="$(awk 'BEGIN{IGNORECASE=1} /^Retry-After:/{gsub(/[^0-9]/,"",$2); if ($2 != "") {print $2; exit}}' "$hdr" 2>/dev/null)"
    if [ -n "$ra" ] && [ "$ra" -gt "$delay" ] 2>/dev/null; then delay="$ra"; fi
    note "Wiki: HTTP 429 (Too Many Requests) - Wiederholung $attempt/$TEAMCTL_RETRY_MAX in ${delay}s"
    sleep "$delay"
  done
}

usage() {
  cat <<'EOF'
teamctl - gemeinsames CLI fuer Wiki, Blog und Git

WIKI (Docmost)
  teamctl wiki spaces
  teamctl wiki pages <spaceId>
  teamctl wiki get <pageId>
  teamctl wiki search <begriff>
  teamctl wiki create --space <spaceId> --title <T> --file <md> [--parent <pageId>]
  teamctl wiki update <pageId> --file <md> [--mode replace|append|prepend]
  teamctl wiki upload <pageId> <bilddatei>
  teamctl wiki me
  teamctl wiki profile --name <name>
  (optional ueberall: --as <email|name>   Standard: writer)

BLOG (statische Seite auf dem Infra-Host)
  teamctl blog list
  teamctl blog publish --file <html> --slug <slug>
  teamctl blog link --title <T> --slug <slug>

GIT (GitHub, Konto per Token)
  teamctl git info <repo>
  teamctl git branches <repo>
  teamctl git commits <repo> [--n <anzahl>]
  teamctl git repos
  teamctl git list <repo> [dir]
  teamctl git create-repo <name> [--public]
  teamctl git upload <repo> <pfad> <lokale-datei> [--message <m>]
  teamctl git read <repo> <pfad> [--ref <branch>]
  teamctl git cat <repo> <pfad>          (Alias fuer read)
  teamctl git clone <repo> [--dir <ziel>] [--branch <b>]
  teamctl git pull <dir>
  teamctl git issue <repo|owner/repo> --title <T> (--body <B> | --file <md>) [--label <l>]
  teamctl git issue-close <repo|owner/repo> <nummer>
  teamctl git issues <repo> [--state open|closed|all] [--label <l>]
  teamctl git issues-all [--state open|closed|all] [--label <l>]
  teamctl git pulls <repo> [--state open|closed|all] [--label <l>]
  teamctl git pulls-all [--state open|closed|all] [--label <l>]

Hinweis:
  teamctl ist ueber einen Symlink in einem PATH-Verzeichnis (z. B. ~/.local/bin)
  auch ohne vollen Pfad als "teamctl" aufrufbar. Bei HTTP 429 (Too Many Requests)
  wiederholt teamctl Wiki-Aufrufe automatisch mit exponentiellem Backoff + Jitter
  (begrenzt; TEAMCTL_RETRY_MAX/BASE/CAP, Defaults 4/2/30).

Konfiguration: siehe teamctl.env im Skript-Verzeichnis (Vorlage: .env.example).
           TEAMCTL_INFRA_HOST TEAMCTL_WIKI_URL TEAMCTL_WIKI_EMAIL TEAMCTL_BLOG_ROOT
           TEAMCTL_GIT_OWNER TEAMCTL_GIT_API TEAMCTL_SSH_KEY TEAMCTL_WIKI_CREDS
EOF
}

# ---------------- SSH ----------------
ssh_ready() { [ -f "$SSH_KEY" ] || die "SSH-Key nicht gefunden: $SSH_KEY (TEAMCTL_SSH_KEY setzen)"; }
ssh_run()  { ssh_ready; ssh -i "$SSH_KEY" "${SSH_OPTS[@]}" "$INFRA_HOST" "$@"; }
scp_to()   { ssh_ready; scp -q -i "$SSH_KEY" "${SSH_OPTS[@]}" "$1" "$INFRA_HOST:$2"; }
scp_from() { ssh_ready; scp -q -i "$SSH_KEY" "${SSH_OPTS[@]}" "$INFRA_HOST:$1" "$2"; }

# ---------------- Wiki (Docmost) ----------------
wiki_resolve_email() {
  local who="$1"
  if [[ "$who" == *@* ]]; then printf '%s' "$who"; return 0; fi
  ssh_run "awk -F'|' -v q='$who' '\$1 ~ /^#/ {next} q ~ /@/ {if (\$3==q) {print \$3; exit} next} \$2==q {print \$3; exit} \$3==q {print \$3; exit} {n=split(\$3,a,\"@\"); if (a[1]==q) {print \$3; exit}}' '$WIKI_CREDS' 2>/dev/null"
}

wiki_login() {
  local who="$1" email pw code
  email="$(wiki_resolve_email "$who")"
  [ -n "$email" ] || die "Wiki-Konto '$who' nicht in $WIKI_CREDS gefunden"
  pw="$(ssh_run "awk -F'|' -v e='$email' '\$3==e{print \$4; exit}' '$WIKI_CREDS' 2>/dev/null")"
  [ -n "$pw" ] || die "Kein Passwort fuer '$email' in $WIKI_CREDS gefunden"
  WIKI_COOKIE="$(mktmp)"
  code="$(wiki_http /dev/null -X POST \
    "$WIKI_BASE/api/auth/login" -H 'Content-Type: application/json' \
    --data-binary "$(jq -nc --arg e "$email" --arg p "$pw" '{email:$e,password:$p}')" \
    -c "$WIKI_COOKIE")"
  [ "$code" = "200" ] || die "Wiki-Login '$email' fehlgeschlagen (HTTP $code)"
}

wiki_api() {
  local ep="$1" body="$2" f
  [ -n "$body" ] || body='{}'
  f="$(mktmp)"
  WIKI_HTTP="$(wiki_http "$f" -X POST "$WIKI_BASE/api/$ep" \
    -H 'Content-Type: application/json' -b "$WIKI_COOKIE" --data-binary "$body")"
  WIKI_BODY="$(cat "$f")"
  case "$WIKI_HTTP" in 200|201) return 0 ;; *) return 1 ;; esac
}

wiki_err() { printf '%s' "$WIKI_BODY" | jq -r '.message // .error // empty' 2>/dev/null | head -1; }

wiki_api_or_die() {
  wiki_api "$1" "$2" || { note "Wiki: HTTP $WIKI_HTTP bei POST /api/$1: $(wiki_err)"; return 1; }
}

wiki_fetch_sidebar() {
  local space="$1" page="$2" body
  if [ -n "$page" ]; then
    body="$(jq -nc --arg s "$space" --arg p "$page" '{spaceId:$s,pageId:$p}')"
  else
    body="$(jq -nc --arg s "$space" '{spaceId:$s}')"
  fi
  wiki_api "pages/sidebar-pages" "$body" || { note "Wiki: HTTP $WIKI_HTTP bei POST /api/pages/sidebar-pages: $(wiki_err)"; return 1; }
}

wiki_print_tree() {
  local space="$1" json="$2" ind="$3" id title hc sub
  while IFS=$'\t' read -r id title hc; do
    [ -n "$id" ] || continue
    printf '%s%s\t%s\n' "$ind" "$id" "$title"
    if [ "$hc" = "true" ]; then
      wiki_fetch_sidebar "$space" "$id"
      sub="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items')"
      wiki_print_tree "$space" "$sub" "$ind  "
    fi
  done < <(printf '%s' "$json" | jq -r '.[] | [.id, .title, (.hasChildren|tostring)] | @tsv')
}

wiki_spaces() {
  wiki_login "$WIKI_AS"
  wiki_api_or_die "spaces/" '{}'
  printf '%s' "$WIKI_BODY" | jq -r '.data.items[] | [.id, .slug, .name] | @tsv'
}

wiki_pages() {
  [ $# -ge 1 ] || die "wiki pages: <spaceId> fehlt"
  local space="$1"
  wiki_login "$WIKI_AS"
  wiki_fetch_sidebar "$space" ""
  local items; items="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items')"
  wiki_print_tree "$space" "$items" ""
}

# Flacht den Seitenbaum eines Spaces ab und gibt je Zeile
# spaceSlug<TAB>pageId<TAB>title aus (fuer wiki search).
wiki_collect_pages() {
  local space="$1" slug="$2" json="$3" id title hc sub
  while IFS=$'\t' read -r id title hc; do
    [ -n "$id" ] || continue
    printf '%s\t%s\t%s\n' "$slug" "$id" "$title"
    if [ "$hc" = "true" ]; then
      wiki_fetch_sidebar "$space" "$id"
      sub="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items')"
      wiki_collect_pages "$space" "$slug" "$sub"
    fi
  done < <(printf '%s' "$json" | jq -r '.[] | [.id, .title, (.hasChildren|tostring)] | @tsv')
}

# Sucht seitenuebergreifend nach Seitentiteln (case-insensitive, fester String).
# Ausgabe: spaceSlug<TAB>pageId<TAB>title.
wiki_search() {
  [ $# -ge 1 ] || die "wiki search: <begriff> fehlt"
  local q="$1" tmp
  [ -n "$q" ] || die "wiki search: Suchbegriff leer"
  wiki_login "$WIKI_AS"
  wiki_api_or_die "spaces/" '{}'
  local spaces
  spaces="$(printf '%s' "$WIKI_BODY" | jq -r '.data.items[] | [.id, .slug] | @tsv')"
  [ -n "$spaces" ] || die "wiki search: keine Spaces sichtbar"
  tmp="$(mktmp)"
  local sid slug items
  while IFS=$'\t' read -r sid slug; do
    [ -n "$sid" ] || continue
    wiki_fetch_sidebar "$sid" "" || continue
    items="$(printf '%s' "$WIKI_BODY" | jq -c '.data.items')"
    wiki_collect_pages "$sid" "$slug" "$items" >> "$tmp"
  done <<< "$spaces"
  grep -iF -- "$q" "$tmp" | sort -f -t $'\t' -k3,3
}

wiki_get() {
  [ $# -ge 1 ] || die "wiki get: <pageId> fehlt"
  local page="$1"
  wiki_login "$WIKI_AS"
  wiki_api_or_die "pages/info" "$(jq -nc --arg p "$page" '{pageId:$p, format:"markdown", includeContent:true}')"
  printf '%s\n\n' "$(printf '%s' "$WIKI_BODY" | jq -r '.data.title')"
  printf '%s\n' "$(printf '%s' "$WIKI_BODY" | jq -r '.data.content // ""')"
}

wiki_create() {
  local space="" title="" file="" parent="" body id rt
  while [ $# -gt 0 ]; do case "$1" in
    --space)  [ $# -ge 2 ] || die "wiki create: --space braucht einen Wert"; space="$2"; shift 2 ;;
    --title)  [ $# -ge 2 ] || die "wiki create: --title braucht einen Wert"; title="$2"; shift 2 ;;
    --file)   [ $# -ge 2 ] || die "wiki create: --file braucht einen Wert"; file="$2"; shift 2 ;;
    --parent) [ $# -ge 2 ] || die "wiki create: --parent braucht einen Wert"; parent="$2"; shift 2 ;;
    --as)     [ $# -ge 2 ] || die "wiki create: --as braucht einen Wert"; WIKI_AS="$2"; shift 2 ;;
    *) die "wiki create: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$space" ] || die "wiki create: --space fehlt"
  [ -n "$title" ] || die "wiki create: --title fehlt"
  [ -n "$file" ] || die "wiki create: --file fehlt"
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  wiki_login "$WIKI_AS"
  if [ -n "$parent" ]; then
    body="$(jq -nc --arg s "$space" --arg t "$title" --arg p "$parent" --rawfile c "$file" '{spaceId:$s,title:$t,parentPageId:$p,content:$c,format:"markdown"}')"
  else
    body="$(jq -nc --arg s "$space" --arg t "$title" --rawfile c "$file" '{spaceId:$s,title:$t,content:$c,format:"markdown"}')"
  fi
  wiki_api_or_die "pages/create" "$body"
  id="$(printf '%s' "$WIKI_BODY" | jq -r '.data.id // empty')"
  [ -n "$id" ] || die "wiki create: keine Page-ID in der Antwort"
  wiki_api_or_die "pages/info" "$(jq -nc --arg p "$id" '{pageId:$p}')"
  rt="$(printf '%s' "$WIKI_BODY" | jq -r '.data.title // empty')"
  [ "$rt" = "$title" ] || die "wiki create: Verifikation fehlgeschlagen (Titel '$rt' != '$title', id=$id)"
  printf '%s\n' "$id"
}

wiki_update() {
  [ $# -ge 1 ] || die "wiki update: <pageId> fehlt"
  local page="$1"; shift
  local file="" mode="replace" body content probe
  while [ $# -gt 0 ]; do case "$1" in
    --file) [ $# -ge 2 ] || die "wiki update: --file braucht einen Wert"; file="$2"; shift 2 ;;
    --mode) [ $# -ge 2 ] || die "wiki update: --mode braucht einen Wert"; mode="$2"; shift 2 ;;
    --as)   [ $# -ge 2 ] || die "wiki update: --as braucht einen Wert"; WIKI_AS="$2"; shift 2 ;;
    *) die "wiki update: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$file" ] || die "wiki update: --file fehlt"
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  case "$mode" in replace|append|prepend) ;; *) die "wiki update: ungueltiger --mode '$mode' (replace|append|prepend)" ;; esac
  wiki_login "$WIKI_AS"
  body="$(jq -nc --arg p "$page" --arg m "$mode" --rawfile c "$file" '{pageId:$p,content:$c,format:"markdown",operation:$m}')"
  wiki_api_or_die "pages/update" "$body"
  wiki_api_or_die "pages/info" "$(jq -nc --arg p "$page" '{pageId:$p, format:"markdown", includeContent:true}')"
  content="$(printf '%s' "$WIKI_BODY" | jq -r '.data.content // ""')"
  probe="$(grep -oE '[A-Za-z0-9]{6,}' "$file" | head -1)"
  if [ -n "$probe" ]; then
    printf '%s' "$content" | grep -qF "$probe" || die "wiki update: Verifikation fehlgeschlagen ('$probe' fehlt, id=$page)"
  fi
  printf 'OK\t%s\t%s\n' "$page" "$mode"
}

wiki_upload() {
  [ $# -ge 2 ] || die "wiki upload: <pageId> <bilddatei> fehlt"
  local page="$1" file="$2" f url code
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  wiki_login "$WIKI_AS"
  f="$(mktmp)"
  WIKI_HTTP="$(wiki_http "$f" -X POST "$WIKI_BASE/api/files/upload" \
    -b "$WIKI_COOKIE" -F "pageId=$page" -F "file=@$file")"
  WIKI_BODY="$(cat "$f")"
  case "$WIKI_HTTP" in 200|201) ;; *) die "HTTP $WIKI_HTTP bei POST /api/files/upload: $(wiki_err)" ;; esac
  url="$(printf '%s' "$WIKI_BODY" | jq -r '.url // .data.url // empty')"
  [ -n "$url" ] || die "wiki upload: keine URL in der Antwort"
  code="$(wiki_http /dev/null -L -b "$WIKI_COOKIE" "$url")"
  [ "$code" = "200" ] || die "wiki upload: Read-back fehlgeschlagen (HTTP $code, $url)"
  printf '%s\n' "$url"
}

wiki_me() {
  wiki_login "$WIKI_AS"
  local f
  f="$(mktmp)"
  WIKI_HTTP="$(wiki_http "$f" -X POST "$WIKI_BASE/api/users/me" -H 'Content-Type: application/json' --data-binary '{}' -b "$WIKI_COOKIE")"
  WIKI_BODY="$(cat "$f")"
  local name
  name="$(printf '%s' "$WIKI_BODY" | jq -r '.data.user.name // empty')"
  printf '%s\n' "$name"
}

wiki_profile() {
  [ $# -ge 1 ] || die "wiki profile: --name <name> fehlt"
  local name=""
  while [ $# -gt 0 ]; do case "$1" in
    --name) [ $# -ge 2 ] || die "wiki profile: --name braucht einen Wert"; name="$2"; shift 2 ;;
    *) die "wiki profile: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$name" ] || die "wiki profile: --name fehlt"

  wiki_login "$WIKI_AS"

  # Set new name
  local body
  body=$(jq -nc --arg n "$name" '{name:$n}')
  wiki_api "users/update" "$body" || die "HTTP $WIKI_HTTP bei POST /api/users/update: $(wiki_err)"

  # Read back
  local f
  f="$(mktmp)"
  WIKI_HTTP="$(wiki_http "$f" -X POST "$WIKI_BASE/api/users/me" -H 'Content-Type: application/json' --data-binary '{}' -b "$WIKI_COOKIE")"
  WIKI_BODY="$(cat "$f")"

  local new_name
  new_name="$(printf '%s' "$WIKI_BODY" | jq -r '.data.user.name // empty')"
  printf 'OK\tName aktualisiert auf: %s\n' "$new_name"
}

wiki_cmd() {
  local args=() sub
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) [ $# -ge 2 ] || die "wiki: --as braucht einen Wert"; WIKI_AS="$2"; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  if [ "${#args[@]}" -gt 0 ]; then set -- "${args[@]}"; else set --; fi
  sub="${1:-}"; shift || true
  case "$sub" in
    spaces) wiki_spaces ;;
    pages)  wiki_pages "$@" ;;
    get)    wiki_get "$@" ;;
    search) wiki_search "$@" ;;
    create) wiki_create "$@" ;;
    update) wiki_update "$@" ;;
    upload) wiki_upload "$@" ;;
    me) wiki_me "$@" ;;
    profile) wiki_profile "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "wiki: unbekannter Unterbefehl (spaces|pages|get|search|create|update|upload)" ;;
  esac
}

# ---------------- Blog ----------------
BLOG_SLUG_RE='^[A-Za-z0-9._-]+$'

blog_list() {
  ssh_run "ls -1 -- '$BLOG_DIR/posts' 2>/dev/null | sed 's/[.]html$//'" || die "blog: Posts nicht lesbar ($BLOG_DIR/posts)"
}

blog_publish() {
  local file="" slug="" tmp out remote_size local_size
  while [ $# -gt 0 ]; do case "$1" in
    --file) [ $# -ge 2 ] || die "blog publish: --file braucht einen Wert"; file="$2"; shift 2 ;;
    --slug) [ $# -ge 2 ] || die "blog publish: --slug braucht einen Wert"; slug="$2"; shift 2 ;;
    *) die "blog publish: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$file" ] || die "blog publish: --file fehlt"
  [ -n "$slug" ] || die "blog publish: --slug fehlt"
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  [[ "$slug" =~ $BLOG_SLUG_RE ]] || die "blog publish: ungueltiger Slug '$slug'"
  tmp="/tmp/teamctl_blog_$$.html"
  scp_to "$file" "$tmp" || die "blog publish: scp fehlgeschlagen"
  out="$(ssh_run "install -m 644 '$tmp' '$BLOG_DIR/posts/$slug.html' && rm -f '$tmp' && wc -c < '$BLOG_DIR/posts/$slug.html'")" || die "blog publish: Deployment fehlgeschlagen"
  remote_size="$(printf '%s' "$out" | tr -d '[:space:]')"
  local_size="$(wc -c < "$file" | tr -d '[:space:]')"
  [ "$remote_size" = "$local_size" ] || die "blog publish: Verifikation fehlgeschlagen (remote=$remote_size lokal=$local_size)"
  printf 'OK\t/posts/%s.html\t%s\n' "$slug" "$remote_size"
}

blog_link() {
  local title="" slug="" tmp before=0 after=0 remote_tmp
  while [ $# -gt 0 ]; do case "$1" in
    --title) [ $# -ge 2 ] || die "blog link: --title braucht einen Wert"; title="$2"; shift 2 ;;
    --slug)  [ $# -ge 2 ] || die "blog link: --slug braucht einen Wert"; slug="$2"; shift 2 ;;
    *) die "blog link: unbekannte Option '$1'" ;;
  esac; done
  [ -n "$title" ] || die "blog link: --title fehlt"
  [ -n "$slug" ] || die "blog link: --slug fehlt"
  [[ "$slug" =~ $BLOG_SLUG_RE ]] || die "blog link: ungueltiger Slug '$slug'"
  tmp="$(mktmp)"
  scp_from "$BLOG_DIR/index.html" "$tmp" || die "blog link: index.html nicht lesbar"
  if grep -qF "href=\"/posts/$slug.html\"" "$tmp"; then
    note "Link fuer '$slug' existiert bereits - keine Aenderung"
    printf 'SKIP\t%s\n' "$slug"
    return 0
  fi
  before="$(grep -c 'href="/posts/' "$tmp" || true)"
  python3 - "$tmp" "$slug" "$title" <<'PY' || die "blog link: index.html Bearbeitung fehlgeschlagen"
import sys, io, html
path, slug, title = sys.argv[1], sys.argv[2], sys.argv[3]
doc = io.open(path, encoding='utf-8').read()
item = '    <li><a href="/posts/%s.html">%s</a></li>\n' % (slug, html.escape(title))
i = doc.rfind('</ul>')
if i == -1:
    sys.stderr.write('kein </ul> in index.html gefunden\n'); sys.exit(1)
io.open(path, 'w', encoding='utf-8').write(doc[:i] + item + doc[i:])
PY
  remote_tmp="/tmp/teamctl_index_$$.html"
  scp_to "$tmp" "$remote_tmp" || die "blog link: scp fehlgeschlagen"
  ssh_run "install -m 644 '$remote_tmp' '$BLOG_DIR/index.html' && rm -f '$remote_tmp'" || die "blog link: Deployment fehlgeschlagen"
  after="$(ssh_run "grep -c 'href=\"/posts/' '$BLOG_DIR/index.html'" || true)"
  [ "$after" -eq "$((before + 1))" ] || die "blog link: Verifikation fehlgeschlagen (vorher=$before nachher=$after)"
  ssh_run "grep -q 'href=\"/posts/$slug.html\"' '$BLOG_DIR/index.html'" || die "blog link: Slug nicht in index.html gefunden"
  printf 'OK\t%s\tlinks=%s\n' "$slug" "$after"
}

blog_cmd() {
  local sub; sub="${1:-}"; shift || true
  case "$sub" in
    list) blog_list ;;
    publish) blog_publish "$@" ;;
    link) blog_link "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "blog: unbekannter Unterbefehl (list|publish|link)" ;;
  esac
}

# ---------------- Git (GitHub) ----------------
GIT_REPO_RE='^[A-Za-z0-9._-]+$'

# Repo-Namen pruefen: erlaubte Zeichen UND keine relativen Pfad-Aliase.
# "." und ".." passen auf ^[A-Za-z0-9._-]+$ und wuerden sonst in API-Pfade
# wie /repos/$GITHUB_OWNER/../... gelangen - daher explizit ablehnen.
git_repo_ok() {
  local name="$1"
  [[ "$name" =~ $GIT_REPO_RE ]] || return 1
  case "$name" in .|..) return 1 ;; esac
  return 0
}

# Datei-/Verzeichnispfade pruefen: leere Pfade, "." und ".." sowie absolute
# Pfade (fuehrendes "/") ablehnen, damit keine API-Pfade wie
# /repos/$GITHUB_OWNER/$repo/contents/../... entstehen.
git_path_ok() {
  local p="$1"
  [ -n "$p" ] || return 1
  case "$p" in .|..) return 1 ;; esac
  case "$p" in /*) return 1 ;; esac
  return 0
}

# Kodiert ein Pfadsegment bzw. einen Branch-Namen fuer die GitHub-Contents-API
# (RFC-3986, jq @uri). Gemeinsamer Helper fuer git_list/git_upload/git_read,
# damit Pfade mit Leerzeichen, #, ?, &, % nicht falsch interpretiert werden.
git_uri_enc() { jq -rn --arg v "$1" '$v|@uri' || die "git: Pfad nicht kodierbar"; }

git_require_repo() {
  local who="$1" name="$2"
  git_repo_ok "$name" || die "$who: ungueltiger Repo-Name '$name'"
}

# Loest ein Repo-Argument in Owner und Repo auf und validiert beide Teile.
# Erlaubt "<repo>" (Owner = $GITHUB_OWNER, bisheriges Verhalten) und
# "<owner>/<repo>" fuer ein fremdes Repo. Setzt die globalen Variablen
# GIT_OWNER und GIT_REPO. Bei "owner/repo" werden BEIDE Teile mit git_repo_ok
# geprueft (lehnt leere Teile, ".", "..", zusaetzliche Slashes und Sonderzeichen
# ab, damit keine Pfad-Traversal-API-Pfade entstehen).
git_owner_repo() {
  local who="$1" arg="$2"
  case "$arg" in
    */*)
      local owner="${arg%%/*}" repo="${arg#*/}"
      git_repo_ok "$owner" || die "$who: ungueltiger Owner-Name '$owner'"
      git_repo_ok "$repo"  || die "$who: ungueltiger Repo-Name '$repo'"
      GIT_OWNER="$owner"; GIT_REPO="$repo"
      ;;
    *)
      git_require_repo "$who" "$arg"
      GIT_OWNER="$GITHUB_OWNER"; GIT_REPO="$arg"
      ;;
  esac
}

git_token() {
  local t
  t="$(eval "$GITHUB_TOKEN_CMD" 2>/dev/null)" || die "git: Token nicht lesbar ($GITHUB_TOKEN_CMD)"
  [ -n "$t" ] || die "git: Token leer"
  printf '%s' "$t"
}

gh_api() {
  local method="$1" path="$2" data="$3" f
  f="$(mktmp)"
  local args=(-sS --max-time 60 -X "$method" \
    -H "Authorization: Bearer $TOK" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    -H "User-Agent: teamctl")
  if [ -n "$data" ]; then args+=(--data-binary "$data"); fi
  GH_HTTP="$(curl "${args[@]}" -o "$f" -w '%{http_code}' "$GITHUB_API$path")"
  GH_BODY="$(cat "$f")"
  case "$GH_HTTP" in 200|201) return 0 ;; *) return 1 ;; esac
}

git_err() { printf '%s' "$GH_BODY" | jq -r '.message // empty' 2>/dev/null | head -1; }

# git_expect_array <kontext>
# Gemeinsamer Helper fuer die listen-artigen git_*-Funktionen: bricht ab
# (Meldung auf stderr, Exit 1), wenn GH_BODY leer oder kein JSON-Array ist.
# Vorher gaben manche Funktionen bei einem GitHub-Fehlerobjekt (.message)
# Text auf STDOUT aus und endeten mit exit 0 (stiller Erfolg) - jetzt ist das
# ein harter Fehler. Die Ausgabe im Array-Fall bleibt unveraendert.
git_expect_array() {
  local who="$1"
  [ -n "$GH_BODY" ] || die "$who: leere API-Antwort"
  printf '%s' "$GH_BODY" | jq -e 'type=="array"' >/dev/null 2>&1 || die "$who: unerwartete API-Antwort: $(git_err)"
}

git_repos() {
  gh_api GET "/user/repos?per_page=100&sort=full_name" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git repos"
  printf '%s' "$GH_BODY" | jq -r '.[] | [.name, (if .private then "private" else "public" end), .default_branch, .pushed_at, .html_url] | @tsv'
}

git_info() {
  [ $# -ge 1 ] || die "git info: <repo> fehlt"
  local repo="$1"
  git_require_repo "git info" "$repo"
  gh_api GET "/repos/$GITHUB_OWNER/$repo" "" || die "HTTP $GH_HTTP: $(git_err)"
  printf '%s' "$GH_BODY" | jq -r '"full_name\t\(.full_name)", "private\t\(.private)", "default_branch\t\(.default_branch)", "description\t\(.description // "")", "html_url\t\(.html_url)", "size_kb\t\(.size)"'
}

# git_branches <repo>
# Listet die Branches eines Repos (read-only) TAB-getrennt:
#   name<TAB>sha(kurz, 7 Zeichen)<TAB>protected(true|false)
# Sortiert nach name (jq sort_by(.name)).
git_branches() {
  [ $# -ge 1 ] || die "git branches: <repo> fehlt"
  local repo="$1"
  git_require_repo "git branches" "$repo"
  gh_api GET "/repos/$GITHUB_OWNER/$repo/branches?per_page=100" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git branches"
  printf '%s' "$GH_BODY" | jq -r 'sort_by(.name)[] | [.name, (.commit.sha[0:7]), ((.protected // false)|tostring)] | @tsv'
}

# git_commits <repo> [--n <anzahl>]
# Listet die letzten Commits eines Repos (read-only) TAB-getrennt:
#   sha(kurz, 7)<TAB>iso-datum<TAB>author-login<TAB>nachricht (erste Zeile)
# Option --n: Anzahl 1..100 (Default 10).
git_commits() {
  [ $# -ge 1 ] || die "git commits: <repo> fehlt"
  local repo="$1"; shift
  local n=10
  while [ $# -gt 0 ]; do case "$1" in
    --n) [ $# -ge 2 ] || die "git commits: --n braucht einen Wert"; n="$2"; shift 2 ;;
    *) die "git commits: unbekannte Option '$1'" ;;
  esac; done
  git_require_repo "git commits" "$repo"
  [[ "$n" =~ ^[0-9]{1,3}$ ]] || die "git commits: ungueltiges --n '$n' (Ganzzahl 1..100)"
  n=$((10#$n))
  if [ "$n" -lt 1 ] || [ "$n" -gt 100 ]; then
    die "git commits: --n ausserhalb 1..100 ('$n')"
  fi
  gh_api GET "/repos/$GITHUB_OWNER/$repo/commits?per_page=$n" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git commits"
  printf '%s' "$GH_BODY" | jq -r '
    .[] | [
      (.sha[0:7]),
      (.commit.author.date // ""),
      (.author.login // .commit.author.name // ""),
      ((.commit.message // "") | split("\n")[0] | gsub("\t"; " ") | gsub("[\r\n]"; " "))
    ] | @tsv'
}

git_list() {
  [ $# -ge 1 ] || die "git list: <repo> fehlt"
  local repo="$1" dir="" path dir_enc
  git_require_repo "git list" "$repo"
  if [ $# -ge 2 ]; then dir="$2"; fi
  path="/repos/$GITHUB_OWNER/$repo/contents"
  if [ -n "$dir" ]; then
    git_path_ok "$dir" || die "git list: ungueltiger Pfad '$dir'"
    dir_enc="$(git_uri_enc "$dir")" || die "git list: Verzeichnis nicht kodierbar"
    path="$path/$dir_enc"
  fi
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git list"
  printf '%s' "$GH_BODY" | jq -r '.[] | [.type, (.size|tostring), .path] | @tsv'
}

git_create_repo() {
  local name="" public=false body
  while [ $# -gt 0 ]; do case "$1" in
    --public)  public=true; shift ;;
    --private) public=false; shift ;;
    -*) die "git create-repo: unbekannte Option '$1'" ;;
    *) name="$1"; shift ;;
  esac; done
  [ -n "$name" ] || die "git create-repo: <name> fehlt"
  body="$(jq -nc --arg n "$name" --argjson p "$public" '{name:$n, private:($p|not), auto_init:true}')"
  gh_api POST "/user/repos" "$body" || die "HTTP $GH_HTTP: $(git_err)"
  printf '%s' "$GH_BODY" | jq -r '[.full_name, ("private=" + (.private|tostring)), .html_url] | @tsv'
}

git_upload() {
  [ $# -ge 3 ] || die "git upload: <repo> <pfad> <lokale-datei> fehlt"
  local repo="$1" path="$2" file="$3"; shift 3
  git_require_repo "git upload" "$repo"
  git_path_ok "$path" || die "git upload: ungueltiger Pfad '$path'"
  local enc; enc="$(git_uri_enc "$path")" || die "git upload: Pfad nicht kodierbar"
  local msg="teamctl: update $path" sha="" body newsha rsha rsize lsize b64
  while [ $# -gt 0 ]; do case "$1" in
    --message) [ $# -ge 2 ] || die "git upload: --message braucht einen Wert"; msg="$2"; shift 2 ;;
    *) die "git upload: unbekannte Option '$1'" ;;
  esac; done
  [ -f "$file" ] || die "Datei nicht gefunden: $file"
  b64="$(base64 -w0 "$file")"
  if gh_api GET "/repos/$GITHUB_OWNER/$repo/contents/$enc" "" 2>/dev/null; then
    sha="$(printf '%s' "$GH_BODY" | jq -r '.sha // empty')"
  fi
  if [ -n "$sha" ]; then
    body="$(jq -nc --arg m "$msg" --arg c "$b64" --arg s "$sha" '{message:$m,content:$c,sha:$s}')"
    note "Datei existiert bereits - wird aktualisiert"
  else
    body="$(jq -nc --arg m "$msg" --arg c "$b64" '{message:$m,content:$c}')"
  fi
  gh_api PUT "/repos/$GITHUB_OWNER/$repo/contents/$enc" "$body" || die "HTTP $GH_HTTP: $(git_err)"
  newsha="$(printf '%s' "$GH_BODY" | jq -r '.content.sha // empty')"
  gh_api GET "/repos/$GITHUB_OWNER/$repo/contents/$enc" "" || die "Read-back HTTP $GH_HTTP: $(git_err)"
  rsha="$(printf '%s' "$GH_BODY" | jq -r '.sha')"
  rsize="$(printf '%s' "$GH_BODY" | jq -r '.size')"
  lsize="$(wc -c < "$file" | tr -d '[:space:]')"
  [ "$rsize" = "$lsize" ] || die "git upload: Verifikation fehlgeschlagen (remote=$rsize lokal=$lsize)"
  if [ -n "$newsha" ]; then
    [ "$rsha" = "$newsha" ] || die "git upload: Verifikation fehlgeschlagen (sha remote=$rsha neu=$newsha)"
  fi
  printf 'OK\t%s/%s\t%s\t%s\n' "$GITHUB_OWNER" "$repo" "$path" "$rsha"
}

# git_read <repo> <pfad> [--ref <branch>]   (Alias: git cat)
# Liest eine Textdatei ueber die GitHub-Contents-API. Der Aufrufer braucht weder
# Token noch URL; das Token bleibt intern und wird nie ausgegeben.
git_read() {
  [ $# -ge 2 ] || die "git read: <repo> <pfad> fehlt"
  local repo="$1" path="$2"; shift 2
  local ref="" enc renc api type size content
  while [ $# -gt 0 ]; do case "$1" in
    --ref) [ $# -ge 2 ] || die "git read: --ref braucht einen Wert"; ref="$2"; shift 2 ;;
    *) die "git read: unbekannte Option '$1'" ;;
  esac; done
  git_require_repo "git read" "$repo"
  [ -n "$path" ] || die "git read: <pfad> fehlt"
  git_path_ok "$path" || die "git read: ungueltiger Pfad '$path'"
  enc="$(git_uri_enc "$path")" || die "git read: Pfad nicht kodierbar"
  api="/repos/$GITHUB_OWNER/$repo/contents/$enc"
  if [ -n "$ref" ]; then
    renc="$(git_uri_enc "$ref")" || die "git read: Branch nicht kodierbar"
    api="$api?ref=$renc"
  fi
  gh_api GET "$api" "" || die "HTTP $GH_HTTP: $(git_err)"
  type="$(printf '%s' "$GH_BODY" | jq -r 'if type=="object" then (.type // "") else "array" end')"
  [ "$type" = "file" ] || die "git read: '$path' ist in $repo keine regulaere Datei (type='${type:-?}')"
  size="$(printf '%s' "$GH_BODY" | jq -r '.size // 0')"
  if [ "${size:-0}" -gt 1000000 ] 2>/dev/null; then
    die "git read: Datei zu gross fuer die Contents-API (${size} Bytes) - stattdessen 'teamctl git clone' nutzen"
  fi
  content="$(printf '%s' "$GH_BODY" | jq -r '.content // "" | gsub("[\\r\\n]"; "") | @base64d')" \
    || die "git read: Inhalt nicht dekodierbar (binaere Datei?)"
  printf '%s\n' "$content"
}

# git_clone <repo> [--dir <ziel>] [--branch <b>]
# Klont ein Team-Repo per HTTPS. Das Token wird ausschliesslich intern als
# HTTP-Header uebergeben (nicht in URL, Kommandozeile oder Ausgabe) und NICHT
# im geklonten Repo gespeichert.
git_clone() {
  [ $# -ge 1 ] || die "git clone: <repo> fehlt"
  local repo="" dir="" branch=""
  while [ $# -gt 0 ]; do case "$1" in
    --dir) [ $# -ge 2 ] || die "git clone: --dir braucht einen Wert"; dir="$2"; shift 2 ;;
    --branch) [ $# -ge 2 ] || die "git clone: --branch braucht einen Wert"; branch="$2"; shift 2 ;;
    -*) die "git clone: unbekannte Option '$1'" ;;
    *) if [ -z "$repo" ]; then repo="$1";
       elif [ -z "$dir" ]; then dir="$1";
       else die "git clone: zu viele Argumente ('$1')"; fi
       shift ;;
  esac; done
  git_require_repo "git clone" "$repo"
  [ -n "$dir" ] || dir="$repo"
  [ -e "$dir" ] && die "git clone: Ziel existiert bereits: $dir"
  local url="https://github.com/$GITHUB_OWNER/$repo.git" hdr ef sha br n
  local args=(--quiet)
  [ -n "$branch" ] && args+=(--branch "$branch")
  hdr="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOK" | base64 -w0)"
  ef="$(mktmp)"
  if ! GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=1 \
       GIT_CONFIG_KEY_0=http.extraHeader GIT_CONFIG_VALUE_0="$hdr" \
       git clone "${args[@]}" "$url" "$dir" >/dev/null 2>"$ef"; then
    sed -n '1,5p' "$ef" >&2
    die "git clone $GITHUB_OWNER/$repo fehlgeschlagen (Ziel: $dir)"
  fi
  sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  br="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  n="$(git -C "$dir" ls-files 2>/dev/null | wc -l | tr -d '[:space:]')"
  note "geklont: $GITHUB_OWNER/$repo -> $dir"
  printf 'OK\t%s/%s\t%s\t%s\t%s\t%s\n' "$GITHUB_OWNER" "$repo" "$dir" "$br" "$sha" "$n"
}

# git_pull <dir>
# Aktualisiert ein zuvor geklontes Repo (nur fast-forward). Token wie bei clone
# ausschliesslich intern; im Repo selbst werden keine Credentials abgelegt.
git_pull() {
  [ $# -ge 1 ] || die "git pull: <dir> fehlt"
  local dir="$1" old new br hdr ef
  [ -d "$dir/.git" ] || die "git pull: kein Git-Repository: $dir"
  old="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  br="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  hdr="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOK" | base64 -w0)"
  ef="$(mktmp)"
  if ! GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=1 \
       GIT_CONFIG_KEY_0=http.extraHeader GIT_CONFIG_VALUE_0="$hdr" \
       git -C "$dir" pull --ff-only --quiet >/dev/null 2>"$ef"; then
    sed -n '1,5p' "$ef" >&2
    die "git pull fehlgeschlagen in $dir"
  fi
  new="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  if [ "$old" = "$new" ]; then
    printf 'OK\t%s\t%s\t%s\tunveraendert\n' "$dir" "$br" "$new"
  else
    printf 'OK\t%s\t%s\t%s..%s\taktualisiert\n' "$dir" "$br" "$old" "$new"
  fi
}

git_issue() {
  [ $# -ge 1 ] || die "git issue: <repo> fehlt"
  local repo="$1"; shift
  local title="" body="" file="" label="" payload num url state
  while [ $# -gt 0 ]; do case "$1" in
    --title) [ $# -ge 2 ] || die "git issue: --title braucht einen Wert"; title="$2"; shift 2 ;;
    --body)  [ $# -ge 2 ] || die "git issue: --body braucht einen Wert"; body="$2"; shift 2 ;;
    --file)  [ $# -ge 2 ] || die "git issue: --file braucht einen Wert"; file="$2"; shift 2 ;;
    --label) [ $# -ge 2 ] || die "git issue: --label braucht einen Wert"; label="$2"; shift 2 ;;
    *) die "git issue: unbekannte Option '$1'" ;;
  esac; done
  git_owner_repo "git issue" "$repo"
  [ -n "$title" ] || die "git issue: --title fehlt"
  if [ -n "$file" ] && [ -n "$body" ]; then die "git issue: --body und --file nicht gleichzeitig"; fi
  if [ -n "$file" ]; then
    [ -f "$file" ] || die "Datei nicht gefunden: $file"
    body="$(cat "$file")"
  fi
  [ -n "$body" ] || die "git issue: --body oder --file fehlt (Text des Wunsches)"
  if [ -n "$label" ]; then
    payload="$(jq -nc --arg t "$title" --arg b "$body" --arg l "$label" '{title:$t, body:$b, labels:($l|split(","))}')"
  else
    payload="$(jq -nc --arg t "$title" --arg b "$body" '{title:$t, body:$b}')"
  fi
  gh_api POST "/repos/$GIT_OWNER/$GIT_REPO/issues" "$payload" || die "HTTP $GH_HTTP: $(git_err)"
  note "POST issues: HTTP $GH_HTTP"
  num="$(printf '%s' "$GH_BODY" | jq -r '.number // empty')"
  url="$(printf '%s' "$GH_BODY" | jq -r '.html_url // empty')"
  [ -n "$num" ] || die "git issue: keine Issue-Nummer in der Antwort"
  gh_api GET "/repos/$GIT_OWNER/$GIT_REPO/issues/$num" "" || die "Read-back HTTP $GH_HTTP: $(git_err)"
  note "GET issue: HTTP $GH_HTTP"
  state="$(printf '%s' "$GH_BODY" | jq -r '.state // empty')"
  [ -n "$state" ] || die "git issue: Read-back ohne state"
  printf 'OK\t%s\t%s\t%s\t%s\n' "$GIT_OWNER/$GIT_REPO" "$num" "$state" "$url"
}

git_issue_close() {
  [ $# -ge 2 ] || die "git issue-close: <repo> <nummer> fehlt"
  local repo="$1" num="$2" payload state url
  git_owner_repo "git issue-close" "$repo"
  [[ "$num" =~ ^[0-9]+$ ]] || die "git issue-close: ungueltige Nummer '$num'"
  payload='{"state":"closed"}'
  gh_api PATCH "/repos/$GIT_OWNER/$GIT_REPO/issues/$num" "$payload" || die "HTTP $GH_HTTP: $(git_err)"
  note "PATCH issue: HTTP $GH_HTTP"
  gh_api GET "/repos/$GIT_OWNER/$GIT_REPO/issues/$num" "" || die "Read-back HTTP $GH_HTTP: $(git_err)"
  note "GET issue: HTTP $GH_HTTP"
  state="$(printf '%s' "$GH_BODY" | jq -r '.state // empty')"
  url="$(printf '%s' "$GH_BODY" | jq -r '.html_url // empty')"
  [ "$state" = "closed" ] || die "git issue-close: Verifikation fehlgeschlagen (state='$state')"
  printf 'OK\t%s\t%s\t%s\t%s\n' "$GIT_OWNER/$GIT_REPO" "$num" "$state" "$url"
}

# Gemeinsame Verarbeitung der Filter-Optionen --state/--label fuer
# listen-artige Git-Befehle (issues/pulls). Setzt die Variablen
# GIT_LIST_STATE (open|closed|all), GIT_LIST_LABEL und GIT_LIST_LABEL_ENC
# (URL-kodierte Form des Labels, leer = keiner).
git_list_opts() {
  local who="$1"; shift
  GIT_LIST_STATE="open"; GIT_LIST_LABEL=""; GIT_LIST_LABEL_ENC=""
  while [ $# -gt 0 ]; do case "$1" in
    --state) [ $# -ge 2 ] || die "$who: --state braucht einen Wert"; GIT_LIST_STATE="$2"; shift 2 ;;
    --label) [ $# -ge 2 ] || die "$who: --label braucht einen Wert"; GIT_LIST_LABEL="$2"; shift 2 ;;
    *) die "$who: unbekannte Option '$1'" ;;
  esac; done
  case "$GIT_LIST_STATE" in open|closed|all) ;; *) die "$who: ungueltiger --state '$GIT_LIST_STATE' (open|closed|all)" ;; esac
  if [ -n "$GIT_LIST_LABEL" ]; then
    GIT_LIST_LABEL_ENC="$(git_uri_enc "$GIT_LIST_LABEL")" || die "$who: Label nicht kodierbar"
  fi
}

# Haengt den labels-Filter (URL-kodiert) an einen Query-Pfad an (falls gesetzt).
git_list_path() {
  local path="$1"
  if [ -n "$GIT_LIST_LABEL_ENC" ]; then
    path="$path&labels=$GIT_LIST_LABEL_ENC"
  fi
  printf '%s' "$path"
}

git_issues() {
  [ $# -ge 1 ] || die "git issues: <repo> fehlt"
  local repo="$1"; shift
  local path
  git_list_opts "git issues" "$@"
  git_require_repo "git issues" "$repo"
  path="$(git_list_path "/repos/$GITHUB_OWNER/$repo/issues?state=$GIT_LIST_STATE&per_page=100")"
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git issues"
  printf '%s' "$GH_BODY" | jq -r '.[] | [.number, .state, .title, ((.labels // []) | map(.name) | join(",")), .html_url] | @tsv'
}

git_issues_all() {
  local path
  git_list_opts "git issues-all" "$@"
  path="$(git_list_path "/user/issues?state=$GIT_LIST_STATE&filter=all&per_page=100")"
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git issues-all"
  printf '%s' "$GH_BODY" | jq -r '
      .[]
      | select(.pull_request == null)
      | [
          (.repository.full_name // "?"),
          .number,
          .state,
          .title,
          ((.labels // []) | map(.name) | join(",")),
          .html_url
        ]
      | @tsv'
}

# git_pulls <repo> [--state open|closed|all] [--label <l>]
# Listet Pull Requests eines Repos (read-only) TAB-getrennt:
#   nummer<TAB>state<TAB>titel<TAB>labels<TAB>autor<TAB>html_url
git_pulls() {
  [ $# -ge 1 ] || die "git pulls: <repo> fehlt"
  local repo="$1"; shift
  local path
  git_list_opts "git pulls" "$@"
  git_require_repo "git pulls" "$repo"
  path="$(git_list_path "/repos/$GITHUB_OWNER/$repo/pulls?state=$GIT_LIST_STATE&per_page=100")"
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git pulls"
  printf '%s' "$GH_BODY" | jq -r '.[] | [.number, .state, .title, ((.labels // []) | map(.name) | join(",")), (.user.login // ""), .html_url] | @tsv'
}

# git_pulls_all [--state open|closed|all] [--label <l>]
# Listet Pull Requests ueber alle sichtbaren Repos (read-only) TAB-getrennt:
#   repo<TAB>nummer<TAB>state<TAB>titel<TAB>labels<TAB>autor<TAB>html_url
git_pulls_all() {
  local path
  git_list_opts "git pulls-all" "$@"
  path="$(git_list_path "/user/issues?state=$GIT_LIST_STATE&filter=all&per_page=100")"
  gh_api GET "$path" "" || die "HTTP $GH_HTTP: $(git_err)"
  git_expect_array "git pulls-all"
  printf '%s' "$GH_BODY" | jq -r '
      .[]
      | select(.pull_request != null)
      | [
          (.repository.full_name // "?"),
          .number,
          .state,
          .title,
          ((.labels // []) | map(.name) | join(",")),
          (.user.login // ""),
          .html_url
        ]
      | @tsv'
}

git_cmd() {
  TOK="$(git_token)"
  local sub; sub="${1:-}"; shift || true
  case "$sub" in
    info) git_info "$@" ;;
    branches) git_branches "$@" ;;
    commits) git_commits "$@" ;;
    repos) git_repos "$@" ;;
    list) git_list "$@" ;;
    create-repo) git_create_repo "$@" ;;
    upload) git_upload "$@" ;;
    read) git_read "$@" ;;
    cat) git_read "$@" ;;
    clone) git_clone "$@" ;;
    pull) git_pull "$@" ;;
    issue) git_issue "$@" ;;
    issue-close) git_issue_close "$@" ;;
    issues) git_issues "$@" ;;
    issues-all) git_issues_all "$@" ;;
    pulls) git_pulls "$@" ;;
    pulls-all) git_pulls_all "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "git: unbekannter Unterbefehl (info|branches|commits|repos|list|create-repo|upload|read|cat|clone|pull|issue|issue-close|issues|issues-all|pulls|pulls-all)" ;;
  esac
}

# ---------------- Dispatch ----------------
cmd="${1:-}"; shift || true
case "$cmd" in
  ""|-h|--help|help) usage; exit 0 ;;
esac
require_config
# CA-Zustand EINMAL im Hauptprozess initialisieren (fail-fast, keine Subshell).
wiki_ca_opts
case "$cmd" in
  wiki) wiki_cmd "$@" ;;
  blog) blog_cmd "$@" ;;
  git)  git_cmd "$@" ;;
  *) die "unbekannter Befehl '$cmd' (wiki|blog|git|help)" ;;
esac
