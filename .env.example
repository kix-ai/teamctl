# teamctl - Konfigurationsvorlage.
# Kopieren nach teamctl.env, echte Werte eintragen, dann: chmod 600 teamctl.env
# teamctl.env darf NICHT in Git. Diese Vorlage enthaelt nur Schluessel/Platzhalter.

TEAMCTL_INFRA_HOST=<user>@<infra-host>
TEAMCTL_WIKI_URL=https://<wiki-host>
TEAMCTL_GIT_OWNER=<github-owner>
TEAMCTL_GIT_API=https://api.github.com
TEAMCTL_WIKI_EMAIL=<wiki-account>@<domain>
TEAMCTL_BLOG_ROOT=/path/to/blog

# Optional (generische Vorgaben im Skript):
# TEAMCTL_SSH_KEY=<pfad-zum-ssh-key>
# TEAMCTL_WIKI_CREDS=<credential-file>
# TEAMCTL_WIKI_AS=<wiki-account>@<domain>
# TEAMCTL_GITHUB_TOKEN_CMD=gh auth token
# TEAMCTL_ENV_FILE=<pfad-zur-teamctl.env>
