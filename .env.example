# teamctl - Konfigurationsvorlage (.env.example)
# Nur Schluessel und Platzhalter eintragen - keine echten Werte/Adressen.
# Zum Verwenden kopieren nach teamctl.env und dort die Werte eintragen.
# teamctl.env ist vertraulich: chmod 600, NICHT in Git.
# teamctl laedt ./teamctl.env im Skript-Verzeichnis (oder $TEAMCTL_ENV_FILE).
# Echte Umgebungsvariablen haben Vorrang vor der Datei.

# --- Pflichtwerte (bewusst OHNE Default im Skript) ---
TEAMCTL_INFRA_HOST=<ssh-host>              # Form: benutzer@<ssh-host>
TEAMCTL_WIKI_URL=<wiki-basis-url>          # z. B. https://wiki.example.com
TEAMCTL_WIKI_EMAIL=<wiki-login-email>
TEAMCTL_BLOG_ROOT=<blog-verzeichnis>       # Pfad auf dem Host
TEAMCTL_GIT_OWNER=<github-owner>           # Account oder Organisation
TEAMCTL_GIT_API=https://api.github.com

# --- Optional ---
TEAMCTL_SSH_KEY=<pfad-zum-ssh-key>             # Default: ~/.ssh/id_ed25519
TEAMCTL_WIKI_CREDS=<pfad-zur-kontendatei>      # Kontendatei auf dem Host
TEAMCTL_WIKI_AS=<email-oder-name>
TEAMCTL_GITHUB_TOKEN_CMD=<befehl-fuer-den-token>   # Default: gh auth token

# --- Retry/Backoff fuer Wiki-Aufrufe bei HTTP 429 (optional) ---
# TEAMCTL_RETRY_MAX=4
# TEAMCTL_RETRY_BASE=2
# TEAMCTL_RETRY_CAP=30
