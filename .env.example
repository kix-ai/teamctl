# teamctl - Konfigurationsvorlage (.env.example)
# Keine echten Werte/Adressen hier eintragen - nur Schluessel und Platzhalter.
# Zum Verwenden kopieren nach teamctl.env und dort die Werte eintragen.
# teamctl.env ist vertraulich: chmod 600, NICHT in Git, NICHT in der Wiki-Doku.
# teamctl laedt $TEAMCTL_ENV_FILE oder ./teamctl.env im Skript-Verzeichnis.
# Echte Umgebungsvariablen haben Vorrang vor der Datei.

# --- Pflichtwerte (bewusst OHNE Default im Skript) ---
TEAMCTL_INFRA_HOST=<infra-host>
TEAMCTL_WIKI_URL=<wiki-url>
TEAMCTL_WIKI_EMAIL=<wiki-email>
TEAMCTL_BLOG_ROOT=<blog-root-pfad>
TEAMCTL_GIT_OWNER=<git-owner>
TEAMCTL_GIT_API=<git-api-url>

# --- Optional ---
TEAMCTL_SSH_KEY=<pfad-zum-ssh-key>
TEAMCTL_WIKI_CREDS=<pfad-zur-credential-datei>
TEAMCTL_WIKI_AS=<email-oder-name>
TEAMCTL_GITHUB_TOKEN_CMD=<kommando-das-den-token-liefert>

# --- Retry/Backoff fuer Wiki-Aufrufe bei HTTP 429 (optional) ---
# Begrenzte Wiederholungen mit exponentiellem Backoff + Jitter.
# TEAMCTL_RETRY_MAX=4
# TEAMCTL_RETRY_BASE=2
# TEAMCTL_RETRY_CAP=30
